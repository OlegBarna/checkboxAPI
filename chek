procedure TFmChek.cmbPaymentTypeChange(Sender: TObject);
var
  NewType, SubType: string;
  Summa, CashAmt, CardAmt: Double;
  CheckID: Integer;
begin
  if FUpdatingPaymentType or FUpdatingFromDataChange then Exit;
  if not DMMag.QChek.Active or DMMag.QChek.IsEmpty then Exit;

  NewType := Trim(cmbPaymentType.Text);
  if NewType = '' then Exit;

  CheckID := DMMag.QChekKOD.AsInteger;
  if CheckID <= 0 then Exit;

  Summa := DMMag.QChekSUMMA.AsFloat;
  SubType := Trim(DMMag.QChekPAYMENT_SUBTYPE.AsString);
  CashAmt := 0;
  CardAmt := 0;

  if NewType = 'Готівка' then
  begin
    CashAmt := Summa;
    CardAmt := 0;
    SubType := '';
  end
  else if NewType = 'Безготівковий' then
  begin
    CashAmt := 0;
    CardAmt := Summa;
    if SubType = '' then
      SubType := 'Картка';
  end
  else if NewType = 'Змішана' then
    begin
      CashAmt := DMMag.QChekCASH_AMOUNT.AsFloat;
      CardAmt := DMMag.QChekCARD_AMOUNT.AsFloat;

      // Якщо одна з сум нульова (типовий перехід з Готівка/Безготівковий) — 50/50
      if (CashAmt <= 0) or (CardAmt <= 0) or
         (Abs(CashAmt + CardAmt - Summa) > 0.01) then
      begin
        CashAmt := Round(Summa * 100 / 2) / 100;  // копійки без втрат
        CardAmt := Summa - CashAmt;
      end;

      if SubType = '' then
        SubType := 'Картка';
    end
  else // Інше
  begin
    CashAmt := 0;
    CardAmt := Summa;
    SubType := '';
  end;

  FUpdatingPaymentType := True;
  try
    // 1. Одразу в БД (тригер проставить PAYMENT_TYPE_I / PAYMENT_SUBTYPE_I)
    FDBManager.UpdatePaymentInfo(
      CheckID,
      NewType,
      CashAmt,
      CardAmt,
      SubType,
      DMMag.QChekIBAN.AsString,
      DMMag.QChekRECIPIENT_NAME.AsString,
      DMMag.QChekPAYMENT_PURPOSE.AsString,
      DMMag.QChekCARD_MASK.AsString,
      DMMag.QChekAUTH_CODE.AsString,
      DMMag.QChekRRN.AsString,
      DMMag.QChekPROVIDER_TYPE.AsString,
      ''
    );

    // 2. Якщо були незавершені правки в датасеті — скасовуємо (дані вже в БД)
    if DMMag.QChek.State in [dsEdit, dsInsert] then
      DMMag.QChek.Cancel;

    // 3. UpdatePaymentInfo уже робить Close/Open QChek — лише оновлюємо UI
    UpdatePaymentControlsVisibility;
    if Assigned(DBGrid1) then
      DBGrid1.Invalidate;

    Log('🔄 Тип оплати збережено в БД: ' + NewType +
        ', підтип=' + SubType +
        ', готівка=' + FloatToStrF(CashAmt, ffNumber, 10, 2) +
        ', картка=' + FloatToStrF(CardAmt, ffNumber, 10, 2));
  finally
    FUpdatingPaymentType := False;
  end;
end;

procedure TFmChek.dbeCardAmountExit(Sender: TObject);
var
  TotalSum, CashAmt, CardAmt: Double;
  S: string;
begin
  if FUpdatingPaymentType or FUpdatingFromDataChange then Exit;
  if not DMMag.QChek.Active or DMMag.QChek.IsEmpty then Exit;
  if Trim(DMMag.QChekPAYMENT_TYPE.AsString) <> 'Змішана' then
  begin
    CashCardExit(Sender);
    Exit;
  end;

  TotalSum := DMMag.QChekSUMMA.AsFloat;

  S := StringReplace(dbeCardAmount.Text, '.', FormatSettings.DecimalSeparator, [rfReplaceAll]);
  S := StringReplace(S, ',', FormatSettings.DecimalSeparator, [rfReplaceAll]);
  CardAmt := StrToFloatDef(S, 0);

  if CardAmt < 0 then
  begin
    ShowMessage('Сума картки не може бути від''ємною.');
    dbeCardAmount.SetFocus;
    dbeCardAmount.SelectAll;
    Exit;
  end;

  if CardAmt > TotalSum + 0.001 then
  begin
    ShowMessage(Format('Картка (%.2f) не може перевищувати суму чека (%.2f).',
      [CardAmt, TotalSum]));
    dbeCardAmount.SetFocus;
    dbeCardAmount.SelectAll;
    Exit;
  end;

  CashAmt := Round((TotalSum - CardAmt) * 100) / 100;

  FUpdatingPaymentType := True;
  try
    if not (DMMag.QChek.State in [dsEdit, dsInsert]) then
      DMMag.QChek.Edit;
    DMMag.QChekCARD_AMOUNT.AsFloat := CardAmt;
    DMMag.QChekCASH_AMOUNT.AsFloat := CashAmt;
  finally
    FUpdatingPaymentType := False;
  end;

  CashCardExit(Sender);
end;

procedure TFmChek.dbeCashAmountExit(Sender: TObject);
var
  TotalSum, CashAmt, CardAmt: Double;
  S: string;
begin
  if FUpdatingPaymentType or FUpdatingFromDataChange then Exit;
  if not DMMag.QChek.Active or DMMag.QChek.IsEmpty then Exit;
  if Trim(DMMag.QChekPAYMENT_TYPE.AsString) <> 'Змішана' then
  begin
    CashCardExit(Sender); // для інших типів просто зберегти
    Exit;
  end;

  TotalSum := DMMag.QChekSUMMA.AsFloat;

  // Текст з контролу → поле
  S := StringReplace(dbeCashAmount.Text, '.', FormatSettings.DecimalSeparator, [rfReplaceAll]);
  S := StringReplace(S, ',', FormatSettings.DecimalSeparator, [rfReplaceAll]);
  CashAmt := StrToFloatDef(S, 0);

  if CashAmt < 0 then
  begin
    ShowMessage('Сума готівки не може бути від''ємною.');
    dbeCashAmount.SetFocus;
    dbeCashAmount.SelectAll;
    Exit;
  end;

  if CashAmt > TotalSum + 0.001 then
  begin
    ShowMessage(Format('Готівка (%.2f) не може перевищувати суму чека (%.2f).',
      [CashAmt, TotalSum]));
    dbeCashAmount.SetFocus;
    dbeCashAmount.SelectAll;
    Exit;
  end;

  CardAmt := Round((TotalSum - CashAmt) * 100) / 100; // без копійкових «хвостів»

  FUpdatingPaymentType := True;
  try
    if not (DMMag.QChek.State in [dsEdit, dsInsert]) then
      DMMag.QChek.Edit;
    DMMag.QChekCASH_AMOUNT.AsFloat := CashAmt;
    DMMag.QChekCARD_AMOUNT.AsFloat := CardAmt;
  finally
    FUpdatingPaymentType := False;
  end;

  // Запис у БД
  CashCardExit(Sender);

  // Фокус на картку + виділити все
  if dbeCardAmount.CanFocus then
  begin
    dbeCardAmount.SetFocus;
    dbeCardAmount.SelectAll;
  end;
end;






