procedure TFmChek.CheckOfflineQueueColumns;
begin
  if FOfflineQueueColsChecked then Exit;
  FOfflineQueueColsChecked := True;   // щоб не пробувати повторно навіть при помилці
  FOfflineQueueHasNewCols  := False;
  try
    if not DMMag.TrMag.Active then
    begin
      Log('⚠️ CheckOfflineQueueColumns: TrMag не активна — пропускаємо');
      Exit;
    end;

    DMMag.SQLQ.Close;
    DMMag.SQLQ.SQL.Text :=
      'SELECT COUNT(*) AS CNT FROM RDB$RELATION_FIELDS ' +
      'WHERE RDB$RELATION_NAME = ''OFFLINE_RECEIPTS_QUEUE'' ' +
      'AND RDB$FIELD_NAME IN (' +
      '  ''CASH_REGISTER_ID'',''CASHIER_LOGIN'',''SHIFT_ID'',''LAST_RETRY_AT'')';
    DMMag.SQLQ.Open;
    if not DMMag.SQLQ.EOF then
      FOfflineQueueHasNewCols := DMMag.SQLQ.FieldByName('CNT').AsInteger = 4;
    DMMag.SQLQ.Close;

    Log('OfflineQueue: нові колонки ' +
        BoolToStr(FOfflineQueueHasNewCols, 'є', 'немає'));
  except
    on E: Exception do
    begin
      Log('⚠️ CheckOfflineQueueColumns: ' + E.Message);
      FOfflineQueueHasNewCols := False;
    end;
  end;
end;

{ Парсер відповіді API offline-кодів. Приймає 3 формати:
    A) top-level масив  [{"fiscal_code":"...",...}, ...]   ← get-offline-codes
    B) {"results":[{"fiscal_code":"..."}, ...]}
    C) envelope {"status":"OK","response":{"results":[...]}}
  Envelope без response → повертає []. }
function TFmChek.ParseOfflineCodesJSON(const AResponse: string;
  const ACR: string): TOfflineCodeArray;
var
  JsonData: TJSONData;
  Root, Envelope: TJSONObject;
  RootArray: TJSONArray;
  Results: TJSONArray;
  ResponseNode: TJSONData;
  FiscalCode: string;

  procedure AddFromArray(Arr: TJSONArray);
  var
    K: Integer;
    FC: string;
  begin
    if Arr = nil then Exit;
    for K := 0 to Arr.Count - 1 do
    begin
      if Arr.Items[K].JSONType <> jtObject then Continue;
      FC := Trim(TJSONObject(Arr.Items[K]).Get('fiscal_code', ''));
      if FC = '' then Continue;
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)].ID := 0;
      Result[High(Result)].FiscalCode := FC;
      Result[High(Result)].CashRegisterID := ACR;
    end;
  end;

begin
  SetLength(Result, 0);
  JsonData := nil;
  try
    try
      JsonData := GetJSON(AResponse);
    except
      on E: Exception do
      begin
        Log('ParseOfflineCodesJSON: не JSON — ' + E.Message);
        Exit;
      end;
    end;

    // ВАРІАНТ A: top-level масив (get-offline-codes)
    if JsonData is TJSONArray then
    begin
      RootArray := TJSONArray(JsonData);
      AddFromArray(RootArray);
      Log(Format('ParseOfflineCodesJSON: масив → %d кодів', [Length(Result)]));
      Exit;
    end;

    // ВАРІАНТ B/C: об'єкт
    if not (JsonData is TJSONObject) then
    begin
      Log('ParseOfflineCodesJSON: корінь не об''єкт і не масив');
      Exit;
    end;

    Root := TJSONObject(JsonData);
    Results := nil;

    if Root.Find('results') <> nil then
      Results := Root.Arrays['results']
    else if Root.Find('response') <> nil then
    begin
      ResponseNode := Root.Find('response');
      if (ResponseNode <> nil) and (ResponseNode.JSONType = jtObject) then
      begin
        Envelope := TJSONObject(ResponseNode);
        if Envelope.Find('results') <> nil then
          Results := Envelope.Arrays['results'];
      end;
    end;

    if Results = nil then
    begin
      // Нормально для async-ack: {"status":"OK","response":null}
      Exit;
    end;

    AddFromArray(Results);
    Log(Format('ParseOfflineCodesJSON: results → %d кодів', [Length(Result)]));
  finally
    if Assigned(JsonData) then JsonData.Free;
  end;
end;

