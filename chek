procedure TFmChek.btnCloseShiftSimpleCurlClick(Sender: TObject);
var
  Response: string;
  ShiftStatus: TShiftStatus;
  Success: Boolean;
  ShiftId: string;
begin
  // ЗАМІНА: Універсальна перевірка для операцій зі зміною
  if not ValidateAPIState(True, False) then  // RequireShift = True
    Exit;

  // ВИПРАВЛЕННЯ: Отримуємо ID зміни
  ShiftId := edtShiftId.Text; // Спершу дивимось у поле вводу

  // Якщо поле вводу порожнє, намагаємось взяти збережений ID
  if ShiftId = '' then
  begin
    ShiftId := FReceiptAPI.CurrentShiftId;
    if ShiftId = '' then
      ShiftId := FReceiptAPI.LoadShiftFromFile; // Додати читання з файлу
    if ShiftId = '' then
    begin
      ShowMessage('Немає активної зміни для закриття');
      Exit;
    end;
    SynchronizeShiftId(ShiftId); // Синхронізуємо всі джерела
  end;

  if not ValidateShiftId(ShiftId) then
  begin
    ShowMessage('Недійсний ID зміни');
    Exit;
  end;

  Log('Просте закриття зміни через CURL...');
  Log('Shift ID: ' + ShiftId);

  // ВИПРАВЛЕННЯ: Видалено непотрібний параметр CashRegisterId
  Success := FReceiptAPI.CloseShiftSimpleCurl(ShiftId, Response, ShiftStatus);

  if Success and Assigned(ShiftStatus) then
  begin
    UpdateShiftStatus(svClosed);
    Log('Запит на закриття зміни успішний!');
    Log('Початковий статус: ' + ShiftStatus.Status);
    Log('ID транзакції закриття: ' + ShiftStatus.ClosingTransactionId);

    // Очікуємо статус CLOSED
    FreeAndNil(ShiftStatus);
    if FReceiptAPI.WaitForShiftStatus(ShiftId, 'CLOSED', Response, ShiftStatus) then
    begin
      if Assigned(ShiftStatus) then
      begin
        Log('Зміну успішно закрито!');
        Log('Статус: ' + ShiftStatus.Status);
        Log('Z-звіт: ' + ShiftStatus.ZReport);
        Log('Серійний номер: ' + IntToStr(ShiftStatus.Serial));
        Log('Час закриття: ' + DateTimeToStr(ShiftStatus.ClosedAt));

        // Отримуємо детальний звіт
        Log('Отримуємо детальний Z-звіт...');
        // Тут може бути виклик GetShiftReportCurl для отримання повного звіту

        // Деактивуємо кнопки
        btnCloseShiftSimpleCurl.Enabled := False;
        btnCloseShiftWithReportCurl.Enabled := False;
        ClearShiftState;
      end;
    end
    else
    begin
      Log('Не вдалося закрити зміну. Остання відповідь: ' + Response);
      ShowMessage('Не вдалося закрити зміну. Перевірте логи для деталей.');
    end;

  end
  else
  begin
    Log('Помилка закриття зміни: ' + Response);
    ShowMessage('Помилка закриття зміни: ' + Response);
  end;
  UpdateAllStatuses;
  if Assigned(ShiftStatus) then
    FreeAndNil(ShiftStatus);
end;



procedure TFmChek.btnCloseShiftWithReportCurlClick(Sender: TObject);
var
  Response, ZReportResponse: string;
  ShiftStatus: TShiftStatus;
  Success: Boolean;
  ShiftId, ZReportId: string;
  StartTime: TDateTime;
begin
  UpdateShiftStatus(svProcessing);

  if not ValidateAPIState(True, False) then
    Exit;

  ShiftId := edtShiftId.Text;
  if ShiftId = '' then
  begin
    ShiftId := FReceiptAPI.CurrentShiftId;
    if ShiftId = '' then
      ShiftId := FReceiptAPI.LoadShiftFromFile;
    if ShiftId = '' then
    begin
      ShowMessage('Немає активної зміни для закриття');
      Exit;
    end;
    SynchronizeShiftId(ShiftId);
  end;

  if not ValidateShiftId(ShiftId) then
  begin
    ShowMessage('Недійсний ID зміни');
    Exit;
  end;

  if MessageDlg('Закриття зміни з Z-звітом',
      'Ви впевнені, що хочете закрити зміну та отримати детальний Z-звіт?' + sLineBreak +
      'Ця операція займе більше часу, але надасть повну фінансову звітність.',
      mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
    Exit;

  Log('=== ПОЧАТОК ЗАКРИТТЯ ЗМІНИ З Z-ЗВІТОМ ===');
  Log('Shift ID: ' + ShiftId);
  StartTime := Now;

  btnCloseShiftWithReportCurl.Enabled := False;
  Screen.Cursor := crHourGlass;
  ShiftStatus := nil;
  ZReportId := '';
  Response := '';
  ZReportResponse := '';

  try
    try
      // === КРОК 1: Закриття зміни ===
      Log('Крок 1: Закриття зміни...');
      FReceiptAPI.ReceiptsDirectory := receiptspath;
      FReceiptAPI.TempDirectory := temppath;
      Success := FReceiptAPI.CloseShiftSimpleCurl(ShiftId, Response, ShiftStatus);

      if not Success then
      begin
        Log('❌ Помилка закриття зміни: ' + Response);
        ShowMessage('Помилка закриття зміни: ' + Copy(Response, 1, 200));
        Exit;
      end;

      if not Assigned(ShiftStatus) then
      begin
        Log('❌ Помилка: ShiftStatus = nil після успішного виклику');
        ShowMessage('Помилка: не вдалося отримати дані зміни');
        Exit;
      end;

      // === КРОК 2: Очікування CLOSED ===
      Log('Крок 2: Очікування завершення закриття...');
      FreeAndNil(ShiftStatus);

      if not FReceiptAPI.WaitForShiftStatus(ShiftId, 'CLOSED', Response, ShiftStatus, 120) then
      begin
        Log('❌ Таймаут очікування закриття зміни: ' + Response);
        ShowMessage('Не вдалося завершити закриття зміни вчасно. Спробуйте пізніше.');
        Exit;
      end;

      if not Assigned(ShiftStatus) then
      begin
        Log('❌ Помилка: ShiftStatus = nil після очікування');
        ShowMessage('Помилка: не вдалося отримати фінальний статус зміни');
        Exit;
      end;

      // === КРОК 3: ID Z-звіту ===
      Log('Крок 3: Отримання детального Z-звіту...');
      ZReportId := ExtractZReportIdFromResponse(Response);

      if ZReportId = '' then
      begin
        if Assigned(ShiftStatus) and (ShiftStatus.ZReport <> '') then
        begin
          ZReportId := ShiftStatus.ZReport;
          // якщо ZReport — це JSON-об'єкт у вигляді рядка, витягнути id
          if (Pos('{', ZReportId) > 0) then
            ZReportId := ExtractZReportIdFromResponse('{"z_report":' + ZReportId + '}');
          Log('Отримано ZReportId з ShiftStatus: ' + ZReportId);
        end
        else
          Log('⚠️ Z-звіт не знайдено у відповіді');
      end;

      // === КРОК 4: Формати Z-звіту (помилки не валять усе закриття) ===
      if ZReportId <> '' then
      begin
        Log('Отримання детального Z-звіту ID: ' + ZReportId);

        // 4.1 JSON
        try
          if FReceiptAPI.GetShiftZReportCurl(ZReportId, ZReportResponse) then
          begin
            Log('✅ Детальний Z-звіт отримано успішно');
            ParseAndShowZReport(ZReportResponse);
          end
          else
            Log('⚠️ Не вдалося отримати детальний Z-звіт: ' + FReceiptAPI.LastError);
        except
          on E: Exception do
            Log('⚠️ Помилка JSON Z-звіту: ' + E.Message);
        end;

        // 4.2 Текст
        try
          GetZReportTextAndSave(ZReportId);
        except
          on E: Exception do
            Log('⚠️ Помилка текстового Z-звіту: ' + E.Message);
        end;

        // 4.3 PNG
        try
          GetZReportPNGAndSave(ZReportId);
        except
          on E: Exception do
            Log('⚠️ Помилка PNG Z-звіту: ' + E.Message);
        end;
      end
      else
      begin
        Log('⚠️ ID Z-звіту не знайдено. Детальний звіт недоступний.');
        ShowMessage('Зміну успішно закрито, але детальний Z-звіт недоступний.');
      end;

      // === КРОК 5: Фіналізація ===
      Log('✅ Зміну успішно закрито з отриманням Z-звіту!');

      if Assigned(ShiftStatus) then
      begin
        Log('Серійний номер: ' + IntToStr(ShiftStatus.Serial));
        Log('Час закриття: ' + DateTimeToStr(ShiftStatus.ClosedAt));
        if Assigned(ShiftStatus.Balance) then
          Log('Фінальний баланс: ' + Format('%.2f грн', [ShiftStatus.Balance.Balance / 100]));
      end;

      btnCloseShiftSimpleCurl.Enabled := False;
      btnCloseShiftWithReportCurl.Enabled := False;
      ClearShiftState;

      Log('Зміну успішно закрито!' + sLineBreak +
          'Z-звіт збережено у різних форматах.' + sLineBreak +
          'Перевірте папку: ' + receiptspath);
      UpdateShiftStatus(svClosed);

    except
      on E: Exception do
      begin
        Log('💥 Виняток при закритті зміни з Z-звітом: ' + E.Message);
        ShowMessage('Критична помилка: ' + E.Message);
      end;
    end;
  finally
    if Assigned(ShiftStatus) then
      FreeAndNil(ShiftStatus);

    btnCloseShiftWithReportCurl.Enabled := True;
    Screen.Cursor := crDefault;
    UpdateAllStatuses;

    Log('=== ЗАВЕРШЕННЯ ЗАКРИТТЯ ЗМІНИ З Z-ЗВІТОМ ===');
    Log('Час виконання: ' + IntToStr(SecondsBetween(Now, StartTime)) + ' сек');
  end;
end;


procedure TFmChek.ParseAndShowZReport(const AZReportJSON: string);
var
  JsonParser: TJSONParser;
  JsonData: TJSONData;
  JsonObj: TJSONObject;
  CleanJSON, ZReportInfo: string;
  P: Integer;
begin
  // Вирізати JSON з можливого «сміття» curl
  CleanJSON := Trim(AZReportJSON);
  P := Pos('{', CleanJSON);
  if P > 0 then
    CleanJSON := Copy(CleanJSON, P, MaxInt);
  P := LastDelimiter('}', CleanJSON);
  if P > 0 then
    CleanJSON := Copy(CleanJSON, 1, P);

  JsonParser := nil;
  JsonData := nil;
  try
    JsonParser := TJSONParser.Create(CleanJSON, [joUTF8]);
    JsonData := JsonParser.Parse;
    if not (JsonData is TJSONObject) then
    begin
      Log('⚠️ Z-звіт: відповідь не є JSON-об''єктом');
      Exit;
    end;
    JsonObj := TJSONObject(JsonData);

    ZReportInfo := 'Z-звіт успішно створено!' + sLineBreak +
                  'ID: ' + JsonObj.Get('id', '') + sLineBreak +
                  'Серійний номер: ' + IntToStr(JsonObj.Get('serial', 0)) + sLineBreak +
                  'Фіскальний код: ' + JsonObj.Get('fiscal_code', '') + sLineBreak +
                  'ID зміни: ' + JsonObj.Get('shift_id', '');

    if JsonObj.Find('payments') <> nil then
      ZReportInfo := ZReportInfo + sLineBreak + 'Кількість платежів: ' +
        IntToStr(JsonObj.Arrays['payments'].Count);
    if JsonObj.Find('taxes') <> nil then
      ZReportInfo := ZReportInfo + sLineBreak + 'Кількість податків: ' +
        IntToStr(JsonObj.Arrays['taxes'].Count);

    Log('Z-звіт проаналізовано: ' + Copy(ZReportInfo, 1, 200));
    // ShowMessage(ZReportInfo);  // за бажанням
  except
    on E: Exception do
    begin
      Log('Помилка парсингу Z-звіту: ' + E.Message);
      // не показувати як критичну — зміна вже закрита
      Log('Фрагмент відповіді: ' + Copy(AZReportJSON, 1, 150));
    end;
  end;
  if Assigned(JsonData) then JsonData.Free;
  if Assigned(JsonParser) then JsonParser.Free;
end;

procedure TFmChek.LoadSettingsFromINI;
var
    dateFolder, targetFolder: string;
begin
   // 0.1. Читання всіх INI-налаштувань через централізований сервіс
   reppath     := ReadReportPath;
   logpath     := ReadLogPath;
   temppath    := ReadTempPath;
   receiptspath := ReadReceiptsPath;

   // Створюємо підпапку за поточною датою
   dateFolder := FormatDateTime('YYYY-MM-DD', Now);
   targetFolder := IncludeTrailingPathDelimiter(receiptspath) + dateFolder;
   if ForceDirectories(targetFolder) then
   begin
     receiptspath := targetFolder;
     Log('✅ Використовується папка за датою: ' + targetFolder);
   end
   else
   begin
     Log('❌ Не вдалося створити/використати папку за датою: ' + targetFolder);
     Log('ℹ️ Використовується кореневий шлях: ' + receiptspath);
   end;

   // SECURE
   level := ReadSecureLevel = 1;

   // OPTIONS
   fmndata.DateEdit1.ReadOnly := (ReadEditDate = 0);
   DMMag.pereschcen := (ReadPereschetCen = 1);
   createlogs := (ReadCreateChkBoxLogs = 1);

   // Ініціалізація лог-файлу (якщо логування активовано)
   if createlogs then InitializeLogFile;

   FTempCurrentKlient := ReadCheckStore;

   // CHECKBOX (секція CHECKBOX)
   FPreviousUseCheckboxAPI := UseCheckboxAPI;
   UseCheckboxAPI := (ReadUseCheckboxAPI = 1);
   GoodsTaxGroup := ReadGoodsTaxGroup;
   edtUsername.Text := ReadUsername;
   edtPassword.Text := ReadPassword;
   edtClientName.Text := ReadClientName;
   edtClientVersion.Text := ReadClientVersion;
   edtBaseURL.Text := ReadBaseURL;
   edtLicenseKey.Text := ReadLicenseKey;
   edtFiscalCode.Text := ReadFiscalCode;
   edtCashRegisterId.Text := ReadCashRegisterId;
   edtPinCode.Text := ReadPin;
   Pinlogin := (ReadPinLogin = 1);
   if not PinLogin then
     rbPassword.Checked := True
   else
     rbPinCode.Checked := True;
   FCashierNameFromIni := ReadCashierName;
   FDepartamentFromIni := ReadDepartament;

   // PRINTER
   FPrinterName := ReadPrinterName;
   FPageLeft    := ReadPageLeft;
   FPageTop     := ReadPageTop;
   FPageWidth   := ReadPageWidth;
   FPageScale   := ReadPageScale;

   Log('Налаштування принтера завантажено:');
   Log(Format('Принтер: %s, Left: %d, Top: %d, Width: %d, Scale: %d',
     [FPrinterName, FPageLeft, FPageTop, FPageWidth, FPageScale]));
end;

