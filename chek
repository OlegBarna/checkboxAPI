procedure TFmChek.UpdateOfflinePanels;
var
  WarnH, WarnM: Integer;
begin
  if not Assigned(StatusBar1) then Exit;
  if StatusBar1.Panels.Count < 6 then Exit;

  WarnH := ReadWarnOfflineHours;
  WarnM := ReadWarnMonthlyHours;

  if not ReadOfflineModeEnabled then
  begin
    SetOfflineCodesPanel('Офлайн-коди: —');
    SetOfflineTimePanel(Format('Офлайн —/%d | Місяць —/%d', [WarnH, WarnM]));
    Exit;
  end;

  // flag=1: рахуємо реальне N (лише якщо менеджер і каса готові)
  if Assigned(FDBManager) and Assigned(FReceiptAPI) and
     (FReceiptAPI.CurrentCashRegisterId <> '') then
  begin
    try
      FOfflineCodesCount :=
        FDBManager.CountFreeOfflineCodes(FReceiptAPI.CurrentCashRegisterId);
    except
      on E: Exception do
        Log('UpdateOfflinePanels: ' + E.Message);
    end;
  end;

  SetOfflineCodesPanel(Format('Офлайн-коди: %d', [FOfflineCodesCount]));

  // Хвилини сесії/місяця — поки що заглушка (E3/E4)
  SetOfflineTimePanel(Format('Офлайн —/%d | Місяць —/%d', [WarnH, WarnM]));
end;

{ E1.3 — Запит кодів у Checkbox, якщо FREE < WarnLowCodes. ТЗ §7.
  Працює лише при flag=1 і валідному токені. Дебаунс 60 сек. }
  { E1.3 — Запит/отримання offline-кодів.
    Потік (за API Checkbox):
      1) get-offline-codes  → забирає ГОТОВІ коди (results)
      2) якщо FREE < WarnLow → ask-offline-codes (async, fire-and-forget)
    ТЗ §7. Дебаунс 60 сек між ask. }
  procedure TFmChek.MaybeAskCodes;
  var
    Response: string;
    HttpCode: Integer;
    Codes: TOfflineCodeArray;
    FreeCount, AskCount, WarnLow, Inserted: Integer;
    CR, CashierLogin: string;
    Asked: Boolean;
  begin
    if not ReadOfflineModeEnabled then Exit;
    if not Assigned(FReceiptAPI) then Exit;
    if not FReceiptAPI.IsTokenValid then Exit;
    if not Assigned(FDBManager) then Exit;

    CR := FReceiptAPI.CurrentCashRegisterId;
    if CR = '' then Exit;

    WarnLow := ReadWarnLowCodes;
    CashierLogin := ReadCashierLogin;
    Asked := False;

    // --- КРОК 1: забрати все ГОТОВЕ з сервера (get) ---
    if FReceiptAPI.GetOfflineCodesCurl(100, Response, HttpCode) and (HttpCode = 200) then
    begin
      Codes := ParseOfflineCodesJSON(Response, CR);
      if Length(Codes) > 0 then
      begin
        try
          Inserted := FDBManager.SaveOfflineCodes(Codes, CashierLogin);
          Log(Format('MaybeAskCodes[get]: отримано %d, вставлено %d',
            [Length(Codes), Inserted]));
        except
          on E: Exception do
            Log('MaybeAskCodes[get]: SaveOfflineCodes FAIL — ' + E.Message);
        end;
      end
      else
        Log('MaybeAskCodes[get]: готових кодів немає (HTTP 200, results порожній/відсутній)');
    end
    else
      Log(Format('MaybeAskCodes[get]: FAIL HTTP %d: %s',
        [HttpCode, Copy(Response, 1, 200)]));

    // --- КРОК 2: перерахувати FREE ---
    try
      FreeCount := FDBManager.CountFreeOfflineCodes(CR);
    except
      on E: Exception do
      begin
        Log('MaybeAskCodes: CountFreeOfflineCodes FAIL — ' + E.Message);
        Exit;
      end;
    end;
    FOfflineCodesCount := FreeCount;
    UpdateOfflinePanels;

    // --- КРОК 3: якщо мало — ініціювати ask (async) з дебаунсом ---
    if FreeCount >= WarnLow then
    begin
      Log(Format('MaybeAskCodes: FREE=%d ≥ WarnLowCodes=%d, ask не потрібен',
        [FreeCount, WarnLow]));
      Exit;
    end;

    if (FLastOfflineAskAt > 0) and
       (SecondsBetween(Now, FLastOfflineAskAt) < 60) then
    begin
      Log(Format('MaybeAskCodes: FREE=%d < %d, але дебаунс (%.0f сек) — пропускаємо ask',
        [FreeCount, WarnLow, SecondsBetween(Now, FLastOfflineAskAt)]));
      Exit;
    end;

    AskCount := WarnLow * 2;
    if AskCount > 100 then AskCount := 100;

    Log(Format('MaybeAskCodes: FREE=%d < %d → ASK count=%d (async, fire-and-forget)',
      [FreeCount, WarnLow, AskCount]));

    Asked := FReceiptAPI.AskOfflineCodesCurl(AskCount, Response, HttpCode);
    if Asked and (HttpCode = 200) then
    begin
      FLastOfflineAskAt := Now;
      Log('MaybeAskCodes[ask]: запит до ДПС поставлено в чергу. ' +
          'Нові коди з’являться через ~10–60 сек → повторний запуск або наступний MaybeAskCodes');
    end
    else
      Log(Format('MaybeAskCodes[ask]: FAIL HTTP %d: %s',
        [HttpCode, Copy(Response, 1, 200)]));
  end;

