procedure TFmChek.SaveReceiptToOfflineQueue(CheckID: Integer; Receipt: TReceipt;
  const JsonString, ErrorResponse: string);
var
  ReceiptUUID: string;
  CashRegID, CashierLogin, ShiftID: string;
begin
  try
    CheckOfflineQueueColumns;    // ← ЛЕДАЧА перевірка тут, БД вже готова
    if Assigned(Receipt) then
      ReceiptUUID := Receipt.Id
    else
      ReceiptUUID := '';

    // Нові поля (E0.6) — заповнюємо, якщо колонки є (інакше тихо пропустимо)
    CashRegID    := '';
    ShiftID      := '';
    CashierLogin := '';
    if FOfflineQueueHasNewCols then
    begin
      if Assigned(FReceiptAPI) then
      begin
        CashRegID := FReceiptAPI.CurrentCashRegisterId;
        ShiftID   := FReceiptAPI.CurrentShiftId;
      end;
      CashierLogin := ReadCashierLogin;   // uAppConfig
    end;

    if FOfflineQueueHasNewCols then
    begin
      // Розширений INSERT — усі колонки (E0.6)
      DMMag.SQLQ.SQL.Text :=
        'INSERT INTO OFFLINE_RECEIPTS_QUEUE (' +
        '  CHECK_ID, RECEIPT_UUID, RECEIPT_JSON, ERROR_MSG, ' +
        '  CREATED_AT, STATUS, RETRY_COUNT, ' +
        '  CASH_REGISTER_ID, CASHIER_LOGIN, SHIFT_ID, LAST_RETRY_AT) ' +
        'VALUES (' +
        '  :CHECK_ID, :RECEIPT_UUID, :RECEIPT_JSON, :ERROR_MSG, ' +
        '  CURRENT_TIMESTAMP, :STATUS_PENDING, 0, ' +
        '  :CASH_REGISTER_ID, :CASHIER_LOGIN, :SHIFT_ID, CURRENT_TIMESTAMP)';

      DMMag.SQLQ.ParamByName('CASH_REGISTER_ID').AsString := CashRegID;
      DMMag.SQLQ.ParamByName('CASHIER_LOGIN').AsString    := CashierLogin;
      DMMag.SQLQ.ParamByName('SHIFT_ID').AsString         := ShiftID;
    end
    else
    begin
      // Legacy INSERT — поведінка prod без змін
      DMMag.SQLQ.SQL.Text :=
        'INSERT INTO OFFLINE_RECEIPTS_QUEUE (' +
        '  CHECK_ID, RECEIPT_UUID, RECEIPT_JSON, ERROR_MSG, ' +
        '  CREATED_AT, STATUS, RETRY_COUNT) ' +
        'VALUES (' +
        '  :CHECK_ID, :RECEIPT_UUID, :RECEIPT_JSON, :ERROR_MSG, ' +
        '  CURRENT_TIMESTAMP, :STATUS_PENDING, 0)';
    end;

    DMMag.SQLQ.ParamByName('CHECK_ID').AsInteger       := CheckID;
    DMMag.SQLQ.ParamByName('STATUS_PENDING').AsString  := FS_PENDING;
    DMMag.SQLQ.ParamByName('RECEIPT_UUID').AsString    := ReceiptUUID;
    DMMag.SQLQ.ParamByName('RECEIPT_JSON').AsString    := JsonString;
    DMMag.SQLQ.ParamByName('ERROR_MSG').AsString       := Copy(ErrorResponse, 1, 500);
    DMMag.SQLQ.ExecSQL;

    if FOfflineQueueHasNewCols then
      Log('Чек ' + IntToStr(CheckID) + ' (UUID: ' + Copy(ReceiptUUID, 1, 8) +
          '...) додано до офлайн-черги [CR=' + Copy(CashRegID, 1, 8) +
          ' Shift=' + Copy(ShiftID, 1, 8) + ']')
    else
      Log('Чек ' + IntToStr(CheckID) + ' (UUID: ' + Copy(ReceiptUUID, 1, 8) +
          '...) додано до офлайн-черги (legacy INSERT)');
  except
    on E: Exception do
    begin
      Log('❌ Помилка збереження в офлайн-чергу: ' + E.Message);
      raise;
    end;
  end;
end;

function TFmChek.ShouldRetryFiscalization(ACheckID: Integer; const AResponse: string;
  CurrentRetry: Integer; const ReceiptIdAlreadySent: string): Boolean;
begin
  if ReceiptIdAlreadySent <> '' then
  begin
    Result := False;
    Log('⛔ Чек вже створений на сервері (ID: ' + ReceiptIdAlreadySent +
        '). Повторна спроба заборонена.');
    Exit;
  end;

  if Assigned(FReceiptAPI) and FReceiptAPI.IsNetworkError(AResponse) then
    Result := CurrentRetry < 3
  else if (Pos('validation', LowerCase(AResponse)) > 0) or
          (Pos('валідації', AResponse) > 0) then
    Result := CurrentRetry < 1
  else if (Pos('shift', LowerCase(AResponse)) > 0) or
          (Pos('offline', LowerCase(AResponse)) > 0) then
    Result := CurrentRetry < 1
  else
    Result := CurrentRetry < 2;

  if not Result then
    Log('Досягнуто максимальну кількість спроб. Поточні: ' + IntToStr(CurrentRetry));
end;


