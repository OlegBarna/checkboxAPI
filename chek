  if not Assigned(FDBManager) then Exit;
  if not Assigned(FReceiptAPI) then Exit;
  if FReceiptAPI.CurrentCashRegisterId = '' then Exit;
  try
    Result := FDBManager.IsOfflineState(FReceiptAPI.CurrentCashRegisterId);
  except
    on E: Exception do
    begin
      Log('IsLocallyOffline: ' + E.Message);
      Result := False;
    end;
  end;
end;

{═══════════════════════════════════════════════════════════════════════════════}
{  E2.1/E2.2 — Allocate → FormatFiscalDate → BuildSellOfflineJson →             }
{  SaveOfflineSaleTransaction. Без API-викликів (ТЗ §6, E2).                    }
{═══════════════════════════════════════════════════════════════════════════════}
function TFmChek.ProcessOfflineSale(CheckID: Integer; Receipt: TReceipt;
  out AError: string): Boolean;
var
  Code: TOfflineCode;
  FiscalDate, JsonString, CR, CashierLogin, ShiftID, UUID: string;
  JsonData: TJSONObject;
begin
  Result := False;
  AError := '';

  if not ReadOfflineModeEnabled then
  begin
    AError := 'OfflineModeEnabled=0';
    Exit;
  end;
  if not Assigned(FDBManager) or not Assigned(FReceiptAPI) then
  begin
    AError := 'FDBManager або FReceiptAPI не ініціалізовано';
    Exit;
  end;
  if not Assigned(Receipt) then
  begin
    AError := 'Receipt = nil';
    Exit;
  end;

  CR := FReceiptAPI.CurrentCashRegisterId;
  ShiftID := FReceiptAPI.CurrentShiftId;
  CashierLogin := ReadCashierLogin;
  UUID := Receipt.Id;

  // 1) Allocate
  if not FDBManager.AllocateOfflineCode(CR, 'SELL', Code) then
  begin
    AError := 'Немає вільних offline-кодів (вичерпано). ' +
              'Перейдіть в онлайн для отримання нових.';
    Exit;
  end;

  // 2) Fiscal date + JSON
  JsonData := nil;
  try
    try
      FiscalDate := FReceiptAPI.FormatFiscalDate(Now);
      JsonData := FReceiptAPI.BuildSellOfflineJson(Receipt, Code.FiscalCode, FiscalDate);
      JsonString := JsonData.AsJSON;
    except
      on E: Exception do
      begin
        FDBManager.ReleaseReservedCode(Code.ID);
        AError := 'Помилка формування JSON: ' + E.Message;
        Exit;
      end;
    end;
  finally
    if Assigned(JsonData) then JsonData.Free;
  end;

  // 3) Save (INSERT queue + UPDATE CHEK + прив'язка коду)
  if not FDBManager.SaveOfflineSaleTransaction(CheckID, CR, CashierLogin,
      ShiftID, UUID, JsonString, Code, AError) then
    Exit; // SaveOfflineSaleTransaction уже звільнив код

  Log(Format('ProcessOfflineSale: OK CheckID=%d, Code=%s, UUID=%s, JSON=%d байт',
    [CheckID, Code.FiscalCode, UUID, Length(JsonString)]));
  Result := True;
end;

