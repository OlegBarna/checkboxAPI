procedure TFmChek.UpdateOfflineButtonsState;
begin
  if not ReadOfflineModeEnabled then Exit;  // flag=0 → стара поведінка
  if not Assigned(FReceiptAPI) then Exit;
  if FReceiptAPI.CurrentCashRegisterId = '' then Exit;

  if IsLocallyOffline then
  begin
    btnGoOffline.Enabled := False;
    btnGoOnline.Enabled  := True;
    Log('UpdateOfflineButtonsState: OFFLINE → btnGoOffline=disabled, btnGoOnline=enabled');
  end
  else
  begin
    btnGoOffline.Enabled := True;
    btnGoOnline.Enabled  := False;
    Log('UpdateOfflineButtonsState: ONLINE → btnGoOffline=enabled, btnGoOnline=disabled');
  end;
end;

