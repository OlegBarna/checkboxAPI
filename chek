{  E3.3.5 — DoGoOnline: перевести касу в онлайн + оновити локальний стан.       }
{═══════════════════════════════════════════════════════════════════════════════}
procedure TFmChek.DoGoOnline;
var
  Response, UsedPath: string;
  HttpCode: Integer;
  Success: Boolean;
  CR: string;
begin
  if not Assigned(FReceiptAPI) then Exit;
  CR := FReceiptAPI.CurrentCashRegisterId;
  if CR = '' then Exit;

  Log('=== DoGoOnline ===');
  UsedPath := '';
  HttpCode := 0;
  Success := FReceiptAPI.GoOnlineCurlWithFallback(UsedPath, HttpCode, Response);

  if Success and (UsedPath <> '') then
  begin
    WriteGoOnlinePathIfChanged(UsedPath);
    WriteGoOnlinePathResolved(True);
  end;

  if (not Success) and (Pos('not_offline', Response) > 0) then
  begin
    Log('ℹ️ API: not_offline — каса вже онлайн');
    Success := True;
  end;

  if Success then
  begin
    Log(Format('✅ GoOnline OK (path=%s, HTTP %d)', [UsedPath, HttpCode]));
    if ReadOfflineModeEnabled then
      if FDBManager.UpdateOfflineStateStop(CR) then
        Log('✅ Локальний стан: IS_OFFLINE=0, seq=0');

    // Примусово оновлюємо панель «Каса» — сервер може ще ~1 сек
    // віддавати offline_mode=true (propagation delay)
    UpdateCashRegisterStatus(svOnline, edtFiscalCode.Text);
  end
  else
  begin
    Log(Format('❌ GoOnline FAIL: HTTP %d, %s', [HttpCode, Copy(Response, 1, 200)]));
    ShowMessage('Не вдалося перевести касу в онлайн:' + sLineBreak +
                Copy(Response, 1, 200));
  end;

  UpdateOfflineButtonsState;
  UpdateOfflinePanels;
  UpdateAllStatuses;
  Log('=== КІНЕЦЬ DoGoOnline ===');
end;

{═══════════════════════════════════════════════════════════════════════════════}
{  E3.3.5 (sync inline) — LoadPendingQueue + ProcessOneReceipt + MarkSynced.    }
{  Виконується у UI-потоці. Безпечно з TrMag.                                   }
{═══════════════════════════════════════════════════════════════════════════════}
procedure TFmChek.RunSyncInline(const ACR, AOwner: string);
var
  Items: TQueueItemArray;
  I: Integer;
  Resp, Status, FC, ID: string;
  HttpCode: Integer;
  Total: Integer;
  Rows, Pend, Err: Integer;

  function ExtractStatus(const AR: string; out ASt, AFC, AID: string): Boolean;
  var
    JD: TJSONData;
  begin
    Result := False;
    ASt := ''; AFC := ''; AID := '';
    JD := nil;
    try
      try
        JD := GetJSON(AR);
      except
        Exit;
      end;
      if not (JD is TJSONObject) then Exit;
      ASt := TJSONObject(JD).Get('status', '');
      AFC := TJSONObject(JD).Get('fiscal_code', '');
      AID := TJSONObject(JD).Get('id', '');
      Result := ASt <> '';
    finally
      if Assigned(JD) then JD.Free;
    end;
  end;

begin
  FSyncOK := 0;
  FSyncPending := 0;
  FSyncError := 0;

  Log('=== SYNC START (CR=' + Copy(ACR, 1, 8) + '... owner=' + Copy(AOwner, 1, 16) + '...) ===');

  Items := FDBManager.LoadPendingQueue(ACR);
  Total := Length(Items);
  if Total = 0 then
  begin
    Log('Sync: черга порожня');
    Exit;
  end;

  Log(Format('Sync: %d чеків у черзі', [Total]));

  for I := 0 to High(Items) do
  begin
    if FSyncRunning = False then
    begin
      Log('Sync: скасовано');
      Break;
    end;

    // Lock ще наш?
    if not FDBManager.IsSyncLockOwner(ACR, AOwner) then
    begin
      Log('Sync: lock втрачено — зупиняємось');
      Break;
    end;

    UpdateAPIStatus(svProcessing, Format('Sync %d/%d', [I + 1, Total]));
    Log(Format('Sync [%d/%d]: %s',
      [I + 1, Total, Copy(Items[I].ReceiptUUID, 1, 8) + '...']));
    Application.ProcessMessages;

    // --- GET /receipts/{uuid} ---
    HttpCode := 0;
    Resp := '';
    if not FReceiptAPI.GetReceiptWithCode(Items[I].ReceiptUUID, Resp, HttpCode) then
    begin
      FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, 'GET curl fail', 1);
      FSyncPending := FSyncPending + 1;
      Sleep(500);
      Continue;
    end;

    if HttpCode = 200 then
    begin
      if ExtractStatus(Resp, Status, FC, ID) then
      begin
        if Status = 'DONE' then
        begin
          Err := 0;
          if FDBManager.MarkSynced(Items[I].ID, Items[I].CheckID, FC, ID, Resp, Resp) then
            FSyncOK := FSyncOK + 1
          else
            FSyncError := FSyncError + 1;
        end
        else if (Status = 'CREATED') or (Status = 'PENDING') then
        begin
          FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, '', 0);
          FSyncPending := FSyncPending + 1;
          Log(Format('Sync: %s ще обробляється (%s)',
            [Copy(Items[I].ReceiptUUID, 1, 8) + '...', Status]));
        end
        else if Status = 'ERROR' then
        begin
          FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR, 'Server status=ERROR', 1);
          FSyncError := FSyncError + 1;
        end
        else
        begin
          FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, 'Unknown status: ' + Status, 0);
          FSyncPending := FSyncPending + 1;
        end;
      end
      else
      begin
        FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, 'GET 200 parse fail', 1);
        FSyncPending := FSyncPending + 1;
      end;
    end
    else if HttpCode = 404 then
    begin
      // POST sell-offline
      HttpCode := 0;
      Resp := '';
      if not FReceiptAPI.PostSellOfflineRawJson(Items[I].ReceiptJSON, Resp, HttpCode) then
      begin
        FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR, 'POST curl fail', 1);
        FSyncError := FSyncError + 1;
      end
      else
      begin
        case HttpCode of
          200, 201:
            begin
              FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, '', 0);
              FSyncPending := FSyncPending + 1;
            end;
          409:
            begin
              if ExtractStatus(Resp, Status, FC, ID) then
                FDBManager.MarkSynced(Items[I].ID, Items[I].CheckID, FC, ID, Resp, Resp)
              else
                FDBManager.SetQueueStatus(Items[I].ID, QS_SYNCED, '409 duplicate', 0);
              FSyncOK := FSyncOK + 1;
            end;
          400:
            begin
              if Pos('offline.code_already_used', Resp) > 0 then
                FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR, 'Код уже використано', 0)
              else if Pos('cash_register.should_be_offline', Resp) > 0 then
              begin
                FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR, 'CR not offline', 0);
                Log('Sync: STOP — каса не в offline на сервері');
                FSyncError := FSyncError + 1;
                Break;
              end
              else
                FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR,
                  'POST 400: ' + Copy(Resp, 1, 200), 1);
              FSyncError := FSyncError + 1;
            end;
          else
            begin
              FDBManager.SetQueueStatus(Items[I].ID, QS_ERROR,
                Format('POST http=%d', [HttpCode]), 1);
              FSyncError := FSyncError + 1;
            end;
        end;
      end;
    end
    else if (HttpCode = 401) or (HttpCode = 403) then
    begin
      Log('Sync: 401/403 — токен недійсний, зупиняємось');
      FDBManager.SetQueueStatus(Items[I].ID, QS_SENT, 'Auth error', 0);
      Break;
    end
    else
    begin
      FDBManager.SetQueueStatus(Items[I].ID, QS_SENT,
        Format('GET http=%d', [HttpCode]), 1);
      FSyncPending := FSyncPending + 1;
    end;

    Sleep(500);
    Application.ProcessMessages;
  end;

  Log(Format('=== SYNC END: OK=%d, PENDING=%d, ERROR=%d ===',
    [FSyncOK, FSyncPending, FSyncError]));
end;

