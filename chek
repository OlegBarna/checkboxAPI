procedure TFmChek.btbtnSendReceiptCurlClick(Sender: TObject);
var
  Receipt: TReceipt;
  Response: string;
  ReceiptResponse: TReceiptResponse;
  Success: Boolean;
  CheckID: Integer;
  RetryCount: Integer;
  MaxRetries: Integer;
  TotalGoodsSum, TotalPaymentsSum: Integer;
  i: Integer;
  UserCancelled: Boolean;
  CurrentRetryCount: Integer;
  LHTMLContent: string;
  LPNGFileName: string;
  LQRCodeFileName: string;
  LTextContent: string;
  TotalFromGoods: Double;
  CheckSumFromDB: Double;
  ValidationError: string;
  JsonString: string;
  ReceiptIdAlreadySent: string;
  PayInfo: TPaymentInfo;
  Details: TPaymentDetails;
  CashKop, CardKop: Integer;
  SubType: Integer;
begin
  // === 1. ЗАХИСТ ВІД ПОВТОРНОГО ВХОДУ ===
  if FIsProcessingFiscalization then
  begin
    Log('Попередження: фіскалізація вже виконується');
    ShowMessage('Фіскалізація вже виконується. Зачекайте завершення...');
    Exit;
  end;

  // === 2. ВАЛІДАЦІЯ ПОЛІВ ОПЛАТИ ===
  if not ValidatePaymentFields then
  begin
    Log('❌ Валідація полів оплати не пройдена');
    Exit;
  end;

  CheckID := DMMag.QChekKOD.AsInteger;
  if CheckID <= 0 then
  begin
    Log('❌ Невірний CheckID: ' + IntToStr(CheckID));
    ShowMessage('Помилка: невірний ідентифікатор чека');
    Exit;
  end;

  // === 3. ЗБЕРЕЖЕННЯ ЗМІН В БД ===
  if DMMag.QChek.State in [dsEdit, dsInsert] then
  begin
    try
      DMMag.QChek.Post;
      Log('Зміни в чеці збережено перед фіскалізацією');
    except
      on E: Exception do
      begin
        Log('❌ Помилка збереження чека: ' + E.Message);
        ShowMessage('Помилка збереження даних чека: ' + E.Message);
        Exit;
      end;
    end;
  end;

  // === 4. ПОЗИЦІОНУВАННЯ QChek ===
  if DMMag.QChekKOD.AsInteger <> CheckID then
  begin
    if not DMMag.QChek.Locate('KOD', CheckID, []) then
    begin
      Log('❌ КРИТИЧНА ПОМИЛКА: не вдалося позиціонувати QChek на чек ' + IntToStr(CheckID));
      ShowMessage('Внутрішня помилка: втрачено позицію чека. Спробуйте ще раз.');
      Exit;
    end;
    Log('QChek перепозиціоновано на чек ' + IntToStr(CheckID));
  end;

  // === 5. ЗЧИТУВАННЯ ДАНИХ ПІСЛЯ Post ===

  // Спочатку пробуємо свіжий SELECT з БД
  if FDBManager.GetPaymentDetails(CheckID, Details) then
  begin
    PayInfo.PaymentTypeUI   := Details.PaymentTypeUI;
    PayInfo.SubTypeUI       := Details.SubTypeUI;
    PayInfo.PaymentTypeCode := Details.PaymentTypeCode;
    PayInfo.SubTypeCode     := Details.SubTypeCode;
    PayInfo.CashAmount      := Details.CashAmount;
    PayInfo.CardAmount      := Details.CardAmount;
    PayInfo.CardMask        := Details.CardMask;
    PayInfo.AuthCode        := Details.AuthCode;
    PayInfo.RRN             := Details.RRN;
    PayInfo.IBAN            := Details.IBAN;
    PayInfo.RecipientName   := Details.RecipientName;
    PayInfo.PaymentPurpose  := Details.PaymentPurpose;
    PayInfo.ProviderUI      := Details.ProviderType;
    PayInfo.ProviderAPI     := ProviderUIToAPI(Details.ProviderType);
  end
  else
  begin
    // Fallback на датасет (на випадок помилки)
    Log('⚠️ GetPaymentDetails не вдалося, читаємо з QChek');
    PayInfo.PaymentTypeUI   := DMMag.QChekPAYMENT_TYPE.AsString;
    PayInfo.SubTypeUI       := DMMag.QChekPAYMENT_SUBTYPE.AsString;
    PayInfo.ProviderUI      := DMMag.QChekPROVIDER_TYPE.AsString;
    PayInfo.CashAmount      := DMMag.QChekCASH_AMOUNT.AsFloat;
    PayInfo.CardAmount      := DMMag.QChekCARD_AMOUNT.AsFloat;
    PayInfo.CardMask        := DMMag.QChekCARD_MASK.AsString;
    PayInfo.AuthCode        := DMMag.QChekAUTH_CODE.AsString;
    PayInfo.RRN             := DMMag.QChekRRN.AsString;
    PayInfo.IBAN            := DMMag.QChekIBAN.AsString;
    PayInfo.RecipientName   := DMMag.QChekRECIPIENT_NAME.AsString;
    PayInfo.PaymentTypeCode := DMMag.QChekPAYMENT_TYPE_I.AsInteger;
    PayInfo.SubTypeCode     := DMMag.QChekPAYMENT_SUBTYPE_I.AsInteger;
    PayInfo.ProviderAPI     := ProviderUIToAPI(PayInfo.ProviderUI);
  end;

  CheckSumFromDB := DMMag.QChekSUMMA.AsFloat;

  if (UpperCase(Trim(PayInfo.PaymentTypeUI)) = 'Готівка') and (PayInfo.CashAmount <= 0) then
  begin
    ShowMessage('Помилка: для готівкової оплати сума готівки повинна бути більше 0.' + sLineBreak +
                'Будь ласка, введіть суму готівки в полі "Готівка".');
    Log('❌ Сума готівки = 0 при типі оплати CASH');
    Exit;
  end;

  if (PayInfo.CashAmount <= 0) and (PayInfo.CardAmount <= 0) then
  begin
    ShowMessage('Помилка: не вказано жодної суми оплати.' + sLineBreak +
                'Введіть суму готівки або картки.');
    Log('❌ Загальна сума оплати = 0');
    Exit;
  end;

  // === 6. ІНІЦІАЛІЗАЦІЯ ===
  Receipt := nil;
  ReceiptResponse := nil;
  UpdateAPIStatus(svProcessing);
  UserCancelled := False;
  LHTMLContent := '';
  LPNGFileName := '';
  LQRCodeFileName := '';
  LTextContent := '';
  ValidationError := '';
  ReceiptIdAlreadySent := '';

  FIsProcessingFiscalization := True;
  btbtnSendReceiptCurl.Enabled := False;
  Screen.Cursor := crHourGlass;

  try
    // === 7. ВАЛІДАЦІЯ ТА ПІДГОТОВКА ===
    FDBManager.ValidateAndRepairCheckData(CheckID);

    if not FDBManager.ValidateCheckSums(CheckID, TotalFromGoods, CheckSumFromDB) then
    begin
      ShowMessage(Format('Неспівпадіння сум:' + sLineBreak +
                        'Сума товарів: %.2f грн' + sLineBreak +
                        'Сума в чеку: %.2f грн' + sLineBreak +
                        'Перевірте коректність даних.',
                        [TotalFromGoods, CheckSumFromDB]));
      Exit;
    end;

    // [E2] Локальна перевірка чека — ДО API-перевірок (щоб працювало в offline)
    if not FDBManager.ValidateCheckForFiscalizationEx(CheckID, ValidationError) then
    begin
      if Pos('вже фіскалізований', ValidationError) > 0 then
      begin
        if MessageDlg('Чек вже фіскалізований',
            'Цей чек вже має фіскальний номер: ' + DMMag.QChekFISCAL_CODE.AsString +
            #13#10'Бажаєте відправити чек повторно?',
            mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
        begin
          UserCancelled := True;
          Log('Користувач відмовився від повторної фіскалізації');
          Exit;
        end;
      end
      else
      begin
        ShowMessage(ValidationError);
        Exit;
      end;
    end;

    // === E2.4: ОФЛАЙН-ГІЛКА ===
    if ReadOfflineModeEnabled and IsLocallyOffline then
    begin
      Log('=== ОФЛАЙН-ПРОДАЖ (локальний стан) ===');

      // Defensive: FReceiptAPI + CurrentCashRegisterId (без ValidateAPIState,
      // бо той робить мережеві перевірки)
      if not Assigned(FReceiptAPI) then
      begin
        ShowMessage('API не ініціалізовано. Неможливо зберегти офлайн-продаж.');
        Exit;
      end;
      if FReceiptAPI.CurrentCashRegisterId = '' then
      begin
        ShowMessage('ID каси не встановлено. Неможливо зберегти офлайн-продаж.');
        Exit;
      end;

      // E2.3: ліміти 36/168
      if not FDBManager.CheckOfflineLimits(FReceiptAPI.CurrentCashRegisterId, ValidationError) then
      begin
        Log('CheckOfflineLimits FAIL: ' + ValidationError);
        ShowMessage('Офлайн-продаж заблоковано:' + sLineBreak + sLineBreak + ValidationError);
        Exit;
      end;

      // Створюємо Receipt ДО перевірки типу (бо Receipt.ReceiptType доступний
      // лише після FillMandatoryReceiptFields)
      Receipt := TReceipt.Create;
      FillMandatoryReceiptFields(Receipt, CheckID, PayInfo);

      // ТЗ §3.1: тільки SELL у offline (defensive — поточний UI цього не порушить,
      // бо FillMandatoryReceiptFields завжди ставить rtSell)
      if Receipt.ReceiptType <> rtSell then
      begin
        ShowMessage('В офлайн-режимі дозволено лише продаж (SELL).' + sLineBreak +
                    'Повернення та службові операції недоступні.');
        Exit;
      end;

      // Проста перевірка сум
      if Receipt.TotalPayment < Receipt.TotalSum then
      begin
        ShowMessage(Format('Сума оплат (%d коп) менша за суму чека (%d коп).',
          [Receipt.TotalPayment, Receipt.TotalSum]));
        Exit;
      end;

      // E2.1/E2.2: Allocate → Build JSON → SaveOfflineSaleTransaction
      if ProcessOfflineSale(CheckID, Receipt, ValidationError) then
      begin
        Log('Offline sale saved: CheckID=' + IntToStr(CheckID));
        ShowMessage('✅ Чек збережено в офлайн-чергу.' + sLineBreak +
                    sLineBreak +
                    'Фіскалізація відбудеться автоматично при переході в онлайн.' + sLineBreak +
                    'Друк чека — лише ПІСЛЯ успішної синхронізації.');
        UpdateOfflinePanels;
      end
      else
      begin
        Log('ProcessOfflineSale FAIL: ' + ValidationError);
        //FDBManager.SetFiscalRetryCount(CheckID, 0);

        // Прямий запис у БД — НЕ через HandleFailedFiscalization,
        // бо ValidationError не є JSON
        FDBManager.UpdateFiscalStatusInDB(CheckID, FS_ERROR, '',
          Copy(ValidationError, 1, 500));
        //UpdateAPIStatus(svError);
        UpdateOfflinePanels;
        ShowMessage('Не вдалося зберегти чек в офлайн-чергу:' + sLineBreak +
                    Copy(ValidationError, 1, 300));
      end;

      Log('=== ЗАВЕРШЕННЯ ОФЛАЙН-ПРОДАЖУ ===');
      Exit;
    end;
    // === /ОФЛАЙН-ГІЛКА ===

    // Далі — online-гілка (без змін):
    if not ValidateAPIState(True, True) then Exit;

    if not IsShiftReadyForFiscalization then
    begin
      Log('Зміна не готова для фіскалізації');
      Exit;
    end;

    if not IsCashRegisterOnline then
    begin
      Log('Каса в офлайн-режимі - фіскалізація неможлива');
      Exit;
    end;

    if not FReceiptAPI.CheckConnectivityCurl(Response) then
    begin
      UpdateAPIStatus(svOffline);
      Log('Відсутнє зʼєднання з інтернетом: ' + Response);
      ShowMessage('Відсутнє підключення до інтернету! Фіскалізація неможлива.');
      Exit;
    end
    else
      Log('Зʼєднання з інтернетом перевірено успішно');

    // === 8. ПІДГОТОВКА ДИРЕКТОРІЙ ===
    FReceiptAPI.ReceiptsDirectory := receiptspath;
    FReceiptAPI.TempDirectory := temppath;
    if not DirectoryExists(FReceiptAPI.ReceiptsDirectory) then
      if not ForceDirectories(FReceiptAPI.ReceiptsDirectory) then
      begin
        Log('❌ Не вдалося створити директорію для чеків');
        ShowMessage('Не вдалося створити папку для збереження чеків. Перевірте права доступу.');
        Exit;
      end;
    if not DirectoryExists(FReceiptAPI.TempDirectory) then
      if not ForceDirectories(FReceiptAPI.TempDirectory) then
      begin
        Log('❌ Не вдалося створити тимчасову директорію');
        ShowMessage('Не вдалося створити тимчасову папку. Перевірте права доступу.');
        Exit;
      end;

    CurrentRetryCount := FDBManager.GetFiscalRetryCount(CheckID);

    try
      Log('=== ПОЧАТОК ФІСКАЛІЗАЦІЇ ЧЕКА ===');
      Log('ID чека: ' + IntToStr(CheckID));
      Log('ID зміни: ' + FReceiptAPI.CurrentShiftId);
      Log('ID каси: ' + FReceiptAPI.CurrentCashRegisterId);

      FDBManager.LogDatabaseState;
      if not DMMag.QChek.Active or not DMMag.QNData.Active then
      begin
        Log('❌ ПОМИЛКА: Запити до БД не активні!');
        ShowMessage('Помилка: втрачено звʼязок з базою даних. Спробуйте ще раз.');
        Exit;
      end;

      // === 9. СТВОРЕННЯ ОБ'ЄКТА ЧЕКА ===
      Receipt := TReceipt.Create;
      FillMandatoryReceiptFields(Receipt, CheckID, PayInfo);

      // === 9a. РОЗБИТТЯ ЗМІШАНОЇ ОПЛАТИ ===
      if (PayInfo.PaymentTypeUI = 'Змішана') or (PayInfo.PaymentTypeCode = 3) then
      begin
        Log('⚠️ Змішана оплата: розбиваємо на CASH + CASHLESS');

        for i := 0 to High(Receipt.Payments) do
          if Assigned(Receipt.Payments[i]) then
            Receipt.Payments[i].Free;
        SetLength(Receipt.Payments, 0);

        CashKop := Round(PayInfo.CashAmount * 100);
        CardKop := Round(PayInfo.CardAmount * 100);

        // Валідація перед відправкою
        if (CashKop <= 0) or (CardKop <= 0) then
          raise Exception.Create(
            'Для змішаної оплати обидві суми мають бути > 0.' + sLineBreak +
            Format('Зараз: готівка=%.2f, картка=%.2f', [PayInfo.CashAmount, PayInfo.CardAmount]) + sLineBreak +
            'Виправте суми в полях «Готівка» / «Картка».');

        if Abs(CashKop + CardKop - Receipt.TotalSum) > 1 then
          raise Exception.Create(
            Format('Сума готівка+картка (%.2f) не дорівнює сумі чека (%.2f).',
              [(CashKop + CardKop) / 100, Receipt.TotalSum / 100]));

        SetLength(Receipt.Payments, 2);

        Receipt.Payments[0] := FReceiptAPI.CreatePayment(ptaCash, CashKop);
        Receipt.Payments[0].LabelText := 'Готівка';

        // Підтип з PayInfo (1=Картка за замовчуванням)
        SubType := PayInfo.SubTypeCode;
        if SubType = 0 then SubType := 1;

        Receipt.Payments[1] := FReceiptAPI.CreateCashlessPayment(CardKop, TCashlessSubType(SubType));
        if (SubType >= Low(CashlessSubTypeUI_Names)) and (SubType <= High(CashlessSubTypeUI_Names)) then
          Receipt.Payments[1].LabelText := CashlessSubTypeUI_Names[SubType];

        Receipt.Payments[1].CardMask := PayInfo.CardMask;
        Receipt.Payments[1].AuthCode := PayInfo.AuthCode;
        Receipt.Payments[1].RRN := PayInfo.RRN;

        Receipt.TotalPayment := CashKop + CardKop;
        Receipt.Rest := Receipt.TotalPayment - Receipt.TotalSum;

        Log(Format('✅ Розбито: CASH=%d kop, CASHLESS=%d kop', [CashKop, CardKop]));
      end;

      // === 9b. ПЕРЕВІРКА СУМ ===
      if Receipt.TotalPayment < Receipt.TotalSum then
      begin
        Log('❌ КРИТИЧНА ПОМИЛКА: TotalPayment < TotalSum!');
        Log('🔄 Спроба автоматичного виправлення сум...');
        Receipt.TotalPayment := Receipt.TotalSum;
        Receipt.Rest := 0;
        if Length(Receipt.Payments) > 0 then
        begin
          Receipt.Payments[0].Value := Receipt.TotalSum;
          Log('✅ Суми автоматично виправлено');
        end
        else
        begin
          ShowMessage('Критична помилка: сума оплати менша за загальну суму чека. Додайте оплату.');
          Exit;
        end;
      end
      else
        Log('✅ Структура чека коректна');

      TotalGoodsSum := 0;
      for i := 0 to High(Receipt.Goods) do
        if Assigned(Receipt.Goods[i]) then
          TotalGoodsSum := TotalGoodsSum + Receipt.Goods[i].TotalSum;
      Log('Сума товарів: ' + FloatToStrF(TotalGoodsSum/100, ffNumber, 10, 2) + ' грн');

      TotalPaymentsSum := 0;
      for i := 0 to High(Receipt.Payments) do
        if Assigned(Receipt.Payments[i]) then
          TotalPaymentsSum := TotalPaymentsSum + Receipt.Payments[i].Value;
      Log('Сума оплат: ' + FloatToStrF(TotalPaymentsSum/100, ffNumber, 10, 2) + ' грн');

      if TotalGoodsSum <> TotalPaymentsSum then
      begin
        Log('❌ ПОМИЛКА: Сума товарів ≠ Сумі оплат!');
        if TotalPaymentsSum < TotalGoodsSum then
        begin
          Log('🔄 Автоматично виправляємо оплату...');
          if Length(Receipt.Payments) > 0 then
          begin
            Receipt.Payments[0].Value := TotalGoodsSum;
            Receipt.TotalPayment := TotalGoodsSum;
            Receipt.Rest := 0;
            Log('✅ Оплату автоматично виправлено');
          end;
        end;
        ShowMessage('Увага: Сума товарів (' + FloatToStrF(TotalGoodsSum/100, ffNumber, 10, 2) +
                   ' грн) не дорівнює сумі оплат (' + FloatToStrF(TotalPaymentsSum/100, ffNumber, 10, 2) + ' грн)' +
                   sLineBreak + 'Спроба автоматичного виправлення...');
      end
      else
        Log('✅ Суми збігаються');

      // ✅ ВИПРАВЛЕНО: Діагностика чека перед відправкою (перехопить ptaMixed, старі label тощо)
      DiagnoseReceipt(Receipt);

      // Формування JSON для офлайн-збереження
      JsonString := '';
      try
        with FReceiptAPI.BuildJsonDataCorrected(Receipt) do
          JsonString := AsJSON;
      except
        on E: Exception do
          Log('⚠️ Не вдалося отримати JSON для офлайн-збереження: ' + E.Message);
      end;

      FDBManager.UpdateFiscalStatusInDB(CheckID, FS_SENT, '', '', '', '', -1, '', '', CurrentRetryCount);

      // === 10. ВІДПРАВКА ЧЕКА ===
      MaxRetries := 3;
      RetryCount := CurrentRetryCount;
      Success := False;
      ReceiptIdAlreadySent := '';

      while RetryCount < MaxRetries do
      begin
        Log(Format('Спроба фіскалізації %d з %d',
            [RetryCount - CurrentRetryCount + 1, MaxRetries - CurrentRetryCount]));

        Success := FReceiptAPI.SendReceiptCurl(Receipt, Response, ReceiptResponse);

        if Success then
        begin
          Log('✅ Відповідь сервера отримана успішно');
          if Assigned(ReceiptResponse) then
            ReceiptIdAlreadySent := ReceiptResponse.Id;
          if RetryCount > CurrentRetryCount then
            FDBManager.ResetFiscalRetryCount(CheckID);
          Break;
        end
        else
        begin
          Log('❌ Помилка спроби ' + IntToStr(RetryCount + 1) + ': ' + Response);
          if (Pos('податк', LowerCase(Response)) <> 0) or (Pos('tax', LowerCase(Response)) <> 0) then
          begin
            ShowMessage('Помилка податкових груп:' + sLineBreak +
                       'Необхідно налаштувати податкові ставки в кабінеті Checkbox.');
            Break;
          end;
          if not ShouldRetryFiscalization(CheckID, Response, RetryCount, ReceiptIdAlreadySent) then
          begin
            Log('⏹️ Подальші спроби припинено');
            Break;
          end;
          Inc(RetryCount);
          if RetryCount < MaxRetries then
          begin
            FDBManager.SetFiscalRetryCount(CheckID, RetryCount);
            Log('🕒 Повторна спроба через 2 секунди...');
            Sleep(2000);
          end;
        end;
      end;

      // === 11. ОБРОБКА РЕЗУЛЬТАТУ ===
      if Success and Assigned(ReceiptResponse) then
      begin
        Log('✅ Запит чека успішно відправлено!');
        Log('ID чека в Checkbox: ' + ReceiptResponse.Id);
        Log('Фіскальний номер: ' + ReceiptResponse.FiscalCode);

        try
          FDBManager.LogDatabaseState;
          FDBManager.SafeCommitAndReopenConnection;
        except
          on E: Exception do
            Log('❌ Помилка збереження даних в БД: ' + E.Message);
        end;

        HandleSuccessfulFiscalization(CheckID, Receipt, ReceiptResponse);

        Log('=== ОТРИМАННЯ ВІЗУАЛІЗАЦІЇ ЧЕКА ===');
        if FReceiptAPI.GetReceiptPNG(ReceiptResponse.Id, LPNGFileName, 30, 58, 75) then
        begin
          Log('✓ PNG отримано: ' + ExtractFileName(LPNGFileName));
          if FileExists(LPNGFileName) then
          begin
            ShowCheck(LPNGFileName);
            if MessageDlg('Чек', 'Надрукувати чек?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
              PrintCheckCustom(LPNGFileName, FPrinterName, FPageLeft, FPageTop, FPageWidth, FPageScale);
          end;
        end
        else
          Log('✗ Помилка отримання PNG: ' + FReceiptAPI.LastError);

        if FReceiptAPI.GetReceiptQRCode(ReceiptResponse.Id, LQRCodeFileName) then
          Log('✓ QR-код отримано');
        if FReceiptAPI.GetReceiptHTML(ReceiptResponse.Id, LHTMLContent) then
          SaveStringToFile(FReceiptAPI.ReceiptsDirectory + '/receipt_' + ReceiptResponse.Id + '.html', LHTMLContent);
        if FReceiptAPI.GetReceiptText(ReceiptResponse.Id, LTextContent) then
          SaveStringToFile(FReceiptAPI.ReceiptsDirectory + '/receipt_' + ReceiptResponse.Id + '.txt', LTextContent);
        Log('=== ЗАВЕРШЕННЯ ВІЗУАЛІЗАЦІЇ ===');
      end
      else
      begin
        Log('❌ Помилка відправки: ' + Response);
        FDBManager.SetFiscalRetryCount(CheckID, RetryCount);
        HandleFailedFiscalization(CheckID, Response);

        if Assigned(FReceiptAPI) and FReceiptAPI.IsNetworkError(Response) then
          ShowMessage('Помилка мережі: Не вдалося зв''язатися з сервером Checkbox.')
        else if Pos('validation', LowerCase(Response)) > 0 then
          ShowMessage('Помилка валідації даних:' + sLineBreak + Copy(Response, 1, 200))
        else
          ShowMessage('Помилка фіскалізації: ' + Copy(Response, 1, 200));
      end;

    except
      on E: Exception do
      begin
        Log('💥 Виняток при фіскалізації: ' + E.Message);
        if not UserCancelled then
          HandleFiscalizationException(CheckID, E);
        ShowMessage('Критична помилка: ' + E.Message);
      end;
    end;

  finally
    Log('Очищення ресурсів...');
    if Assigned(Receipt) then FreeAndNil(Receipt);
    if Assigned(ReceiptResponse) then FreeAndNil(ReceiptResponse);

    btbtnSendReceiptCurl.Enabled := True;
    Screen.Cursor := crDefault;
    FIsProcessingFiscalization := False;

    Log('=== ЗАВЕРШЕННЯ ФІСКАЛІЗАЦІЇ ===');
    UpdateAllStatuses;
  end;
end;

// Для внесення готівки
procedure TFmChek.btnCashInClick(Sender: TObject);
var
  Response: string;
  ReceiptResponse: TReceiptResponse;
  Amount: Integer;
begin
  // 1. Перевірка стану API та каси
  if not ValidateAPIState(False, True) then
    Exit;

  // 2. Отримуємо суму з поля введення
  Amount := GetAmountInKopiyky;

  if Amount <= 0 then
  begin
    ShowMessage('Введіть коректну суму!');
    fseAmount.SetFocus;
    Exit;
  end;

  // 3. Перевірка — для внесення не потрібно перевіряти баланс
  //    (готівку завжди можна внести, якщо зміна відкрита)

  // 4. Підтвердження операції
  if MessageDlg(
    'Підтвердження внесення готівки',
    'Ви впевнені, що хочете внести ' + FormatFloat('0.00', Amount / 100) + ' грн в касу?',
    mtConfirmation, [mbYes, mbNo], 0
  ) <> mrYes then
    Exit;

  // 5. Логування операції
  Log('Операція внесення готівки: ' + FormatFloat('0.00', Amount / 100) + ' грн');

  // 6. Виконуємо операцію
  if FReceiptAPI.CashIncome(Amount, '', Response, ReceiptResponse) then
  begin
    // 7. Успіх — оновлюємо баланс
    UpdateBalanceAfterOperation;
    ShowMessage(
      'Готівку внесено успішно!' + sLineBreak +
      sLineBreak +
      'ID чека: ' + ReceiptResponse.Id + sLineBreak +
      'Сума: ' + FormatFloat('0.00', Amount / 100) + ' грн' + sLineBreak +
      'Баланс в касі: ' + FormatFloat('0.00', FCurrentBalance / 100) + ' грн'
    );

    fseAmount.Value := 0;
  end
  else
  begin
    ShowMessage('Помилка внесення готівки:' + sLineBreak + Response);
  end;
  UpdateAllStatuses;
  // 8. Очищення та оновлення UI
  if Assigned(ReceiptResponse) then
    FreeAndNil(ReceiptResponse);
end;


// Для винесення готівки
procedure TFmChek.btnCashOutClick(Sender: TObject);
var
  Response: string;
  ReceiptResponse: TReceiptResponse;
  Amount: Integer;
begin
  // 1. Перевірка стану API та каси
  if not ValidateAPIState(False, True) then
    Exit;

  // 2. Отримуємо суму з поля введення
  Amount := GetAmountInKopiyky;

  if Amount <= 0 then
  begin
    ShowMessage('Введіть коректну суму!');
    fseAmount.SetFocus;
    Exit;
  end;

  // 3. Перевірка балансу — використовуємо FCurrentBalance (без API-запиту!)
  // FCurrentBalance оновлюється при відкритті зміни та після кожної операції
  if FCurrentBalance <= 0 then
  begin
    ShowMessage(
      'Недостатньо коштів в касі для винесення!' + sLineBreak +
      sLineBreak +
      'Поточний баланс: ' + FormatFloat('0.00', FCurrentBalance / 100) + ' грн' + sLineBreak +
      sLineBreak +
      'Перевірте, чи відкрита зміна та чи є готівка в касі.'
    );
    Exit;
  end;

  if Amount > FCurrentBalance then
  begin
    ShowMessage(
      'Недостатньо коштів в касі для винесення!' + sLineBreak +
      sLineBreak +
      'Доступно: ' + FormatFloat('0.00', FCurrentBalance / 100) + ' грн' + sLineBreak +
      'Спроба винесення: ' + FormatFloat('0.00', Amount / 100) + ' грн'
    );
    Exit;
  end;

  // 4. Підтвердження операції
  if MessageDlg(
    'Підтвердження винесення готівки',
    'Ви впевнені, що хочете винести ' + FormatFloat('0.00', Amount / 100) + ' грн з каси?',
    mtConfirmation, [mbYes, mbNo], 0
  ) <> mrYes then
    Exit;

  // 5. Логування операції (опис НЕ передається в API)
  Log('Операція винесення готівки: ' + FormatFloat('0.00', Amount / 100) + ' грн');

  // 6. Виконуємо операцію
  //    Параметр ADescription = '' — API /receipts/service не підтримує description
  if FReceiptAPI.CashOutcome(Amount, '', Response, ReceiptResponse) then
  begin
    // 7. Успіх — оновлюємо баланс
    UpdateBalanceAfterOperation;
    ShowMessage(
