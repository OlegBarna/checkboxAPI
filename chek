procedure TFmChek.InitializeCheckboxAPI;
var
  Response, ShiftId, AuthResponse, Err: string;
  ShiftStatus: TShiftStatus;
  CRStatus: TCashRegisterStatus;
  i: Integer;
begin
  // Початкові статуси
  UpdateAPIStatus(svProcessing, 'Ініціалізація...');
  UpdateCashierStatus(svUnknown);
  UpdateCashRegisterStatus(svUnknown);
  UpdateShiftStatus(svUnknown);

  Log('Перевірка стану Checkbox API...');

  // Базова перевірка API
  if not ValidateAPIState(False, False) then
  begin
    Log('❌ Не вдалося ініціалізувати API або авторизуватися');
    UpdateAPIStatus(svError, 'Помилка ініціалізації');
    UpdateCashierStatus(svError, 'Помилка авторизації');
    Exit;
  end;

  Log('API успішно ініціалізовано та авторизовано');
  UpdateAPIStatus(svOnline);
  UpdateCashierInfo;
  LoadCashRegisterPreferences;

  // --- КАСА ---
  if FReceiptAPI.CurrentCashRegisterId = '' then
  begin
    Log('Спроба автоматичного вибору оптимальної каси...');
    UpdateCashRegisterStatus(svProcessing, 'Автоматичний вибір...');

    if InitializeOptimalCashRegister(Response) then
    begin
      Log('Касу автоматично обрано: ' + Copy(FReceiptAPI.CurrentCashRegisterId, 1, 8) + '...');
      SaveCashRegisterPreferences;
      RefreshCashRegisterList;
    end
    else
    begin
      Log('Не вдалося автоматично обрати касу: ' + Response);
      UpdateCashRegisterStatus(svError, 'Не вдалося обрати');
      RefreshCashRegisterList;

      if Length(FCashRegisters) > 0 then
        ShowMessage('Не вдалося автоматично обрати касу.' + sLineBreak +
                   'Будь ласка, виберіть касу вручну зі списку.')
      else
        ShowMessage('Не вдалося отримати список кас. Перевірте зʼєднання.');
    end;
  end
  else
  begin
    Log('Використовуємо збережену касу: ' + Copy(FReceiptAPI.CurrentCashRegisterId, 1, 8) + '...');
    RefreshCashRegisterList;

    // E3.1: отримати реальний стан каси (offline_mode) з сервера
    CRStatus := nil;
    try
      if FReceiptAPI.GetCashRegisterStatusCurl(FReceiptAPI.CurrentCashRegisterId,
           AuthResponse, CRStatus) and Assigned(CRStatus) then
      begin
        if CRStatus.Active then
        begin
          if CRStatus.OfflineMode then
            UpdateCashRegisterStatus(svOffline, CRStatus.FiscalNumber)
          else
            UpdateCashRegisterStatus(svOnline, CRStatus.FiscalNumber);
        end
        else
          UpdateCashRegisterStatus(svError, 'Неактивна');

        // Синхронізація локального offline-стану з серверним
        if ReadOfflineModeEnabled then
        begin
          if CRStatus.OfflineMode and
             not FDBManager.IsOfflineState(FReceiptAPI.CurrentCashRegisterId) then
          begin
            Err := '';
            if FDBManager.UpdateOfflineStateStart(FReceiptAPI.CurrentCashRegisterId, Err) then
              Log('ℹ️ Сервер offline → локально IS_OFFLINE=1')
            else
              Log('⚠️ Не вдалося виставити offline: ' + Err);
          end
          else if (not CRStatus.OfflineMode) and
                  FDBManager.IsOfflineState(FReceiptAPI.CurrentCashRegisterId) then
          begin
            if FDBManager.UpdateOfflineStateStop(FReceiptAPI.CurrentCashRegisterId) then
              Log('ℹ️ Сервер online → локально IS_OFFLINE=0')
            else
              Log('⚠️ Не вдалося скинути offline');
          end;
        end;
      end
      else
        Log('⚠️ Не вдалося отримати статус каси: ' + Copy(AuthResponse, 1, 100));
    finally
      if Assigned(CRStatus) then FreeAndNil(CRStatus);
    end;
  end;

  // Перевірка ID каси
  if FReceiptAPI.CurrentCashRegisterId = '' then
  begin
    Log('⚠️ УВАГА: ID каси не встановлено! Операції з готівкою будуть неможливі.');
    UpdateCashRegisterStatus(svError, 'ID не встановлено');
  end
  else
    Log('✅ ID каси встановлено: ' + Copy(FReceiptAPI.CurrentCashRegisterId, 1, 8) + '...');

  // --- ЗМІНА ---
  ShiftStatus := nil;
  CRStatus := nil;
  ShiftId := FReceiptAPI.LoadShiftFromFile;

  if ShiftId <> '' then
  begin
    Log('Знайдено збережену зміну: ' + Copy(ShiftId, 1, 8) + '...');
    UpdateShiftStatus(svProcessing, 'Перевірка...');

    if FReceiptAPI.GetShiftStatusCurl(ShiftId, AuthResponse, ShiftStatus) and Assigned(ShiftStatus) then
    begin
      try
        if ShiftStatus.Status = 'OPENED' then
        begin
          SynchronizeShiftId(ShiftStatus.Id);
          btnCloseShiftSimpleCurl.Enabled := True;
          if ShiftStatus.Serial > 0 then
            UpdateShiftStatus(svOpened, '№' + IntToStr(ShiftStatus.Serial))
          else
            UpdateShiftStatus(svOpened);

          Log('Зміну успішно відновлено: ' + ShiftStatus.Id + sLineBreak +
              'Номер: ' + IntToStr(ShiftStatus.Serial) + sLineBreak +
              'Відкрита: ' + DateTimeToStr(ShiftStatus.OpenedAt));

          if Assigned(ShiftStatus.Balance) then
          begin
            FCurrentBalance := ShiftStatus.Balance.Balance;
            UpdateCashBalance;
            Log(Format('Баланс відновленої зміни: %.2f грн', [FCurrentBalance / 100]));
          end;
        end
        else
        begin
          // Файл є, але зміна вже не OPENED — повністю очищаємо локальний стан
          Log('Збережена зміна неактивна. Статус: ' + ShiftStatus.Status);
          UpdateShiftStatus(svClosed, 'Неактивна');
          ClearShiftState;   // [FIX] CurrentShiftId + файл + edt + кнопка
          ShiftId := '';     // [RECOVERY] далі спробуємо сервер
        end;
      finally
        FreeAndNil(ShiftStatus);
      end;
    end
    else
    begin
      Log('Не вдалося перевірити статус зміни: ' + AuthResponse);
      UpdateShiftStatus(svError, 'Помилка перевірки');

      if MessageDlg('Помилка перевірки',
          'Не вдалося перевірити статус збереженої зміни.' + sLineBreak +
          'Можливі причини:' + sLineBreak +
          '- Втрачено зв''язок з сервером' + sLineBreak +
          '- Зміна була видалена' + sLineBreak +
          '- Проблеми з авторизацією' + sLineBreak + sLineBreak +
          'Видалити збережений стан?',
          mtWarning, [mbYes, mbNo], 0) = mrYes then
      begin
        ClearShiftState;   // [FIX] повне очищення, не лише файл
        Log('Користувач видалив збережений стан зміни');
        ShiftId := '';     // [RECOVERY] далі спробуємо сервер
      end
      else
        Log('Користувач зберіг стан зміни для подальших спроб');
    end;
  end;

  // [RECOVERY] Файл порожній (або очищений вище), але на касі може бути OPENED
  // (краш під час відкриття до SaveShiftToFile / ручне відкриття в іншому клієнті)
  if (ShiftId = '') and (FReceiptAPI.CurrentShiftId = '') and
     (FReceiptAPI.CurrentCashRegisterId <> '') then
  begin
    Log('Локального ID зміни немає — перевіряємо статус каси на сервері...');
    UpdateShiftStatus(svProcessing, 'Пошук на сервері...');

    CRStatus := nil;
    try
      if FReceiptAPI.GetCashRegisterStatusCurl(FReceiptAPI.CurrentCashRegisterId,
           AuthResponse, CRStatus) and Assigned(CRStatus) then
      begin
        if CRStatus.ShiftStatus = 'OPENED' then
        begin
          // [FIX] Пріоритет 1: ID зі status каси — гарантовано скоуплено за касою
          ShiftId := CRStatus.CurrentShiftId;
          if ShiftId <> '' then
            Log('ID зміни взято зі статусу каси: ' + Copy(ShiftId, 1, 8) + '...')
          else
          begin
            // [FIX] Пріоритет 2 (fallback): окремий запит, з фільтром за касою
            Log('Каса OPENED, але shift.id відсутній у status — fallback...');
            ShiftId := FReceiptAPI.GetCurrentShiftIdCurl(AuthResponse);
            if ShiftId <> '' then
              Log('ID зміни отримано через GetCurrentShiftIdCurl: ' +
                  Copy(ShiftId, 1, 8) + '...');
          end;

          if ShiftId <> '' then
          begin
            if FReceiptAPI.GetShiftStatusCurl(ShiftId, AuthResponse, ShiftStatus) and
               Assigned(ShiftStatus) and (ShiftStatus.Status = 'OPENED') then
            begin
              try
                // [FIX] Додаткова перевірка: зміна має належати поточній касі
                if (ShiftStatus.CashRegisterId <> '') and
                   (ShiftStatus.CashRegisterId <> FReceiptAPI.CurrentCashRegisterId) then
                begin
                  Log('⚠️ ID зміни належить ІНШІЙ касі (' +
                      Copy(ShiftStatus.CashRegisterId, 1, 8) + '... ≠ ' +
                      Copy(FReceiptAPI.CurrentCashRegisterId, 1, 8) + '...). Відкидаємо.');
                  UpdateShiftStatus(svError, 'Чужа зміна');
                  // НЕ робимо Synchronize — це б завело нас на чужу касу
                end
                else
                begin
                  // SynchronizeShiftId вже робить SaveShiftToFile — дубль не потрібен
                  SynchronizeShiftId(ShiftStatus.Id);
                  btnCloseShiftSimpleCurl.Enabled := True;

                  if ShiftStatus.Serial > 0 then
                    UpdateShiftStatus(svOpened, '№' + IntToStr(ShiftStatus.Serial))
                  else
                    UpdateShiftStatus(svOpened);

                  Log('Зміну відновлено з сервера: ' + ShiftStatus.Id +
                      IfThen(ShiftStatus.Serial > 0,
                        ' №' + IntToStr(ShiftStatus.Serial), ''));

                  if Assigned(ShiftStatus.Balance) then
                  begin
                    FCurrentBalance := ShiftStatus.Balance.Balance;
                    UpdateCashBalance;
                    Log(Format('Баланс: %.2f грн', [FCurrentBalance / 100]));
                  end;
                end;
              finally
                FreeAndNil(ShiftStatus);
              end;
            end
            else
            begin
              Log('GetShiftStatusCurl не підтвердив OPENED');
              if Assigned(ShiftStatus) then
                FreeAndNil(ShiftStatus);
              UpdateShiftStatus(svClosed, 'Не знайдена');
            end;
          end
          else
          begin
            Log('Каса OPENED, але ID зміни отримати не вдалося: ' + AuthResponse);
            UpdateShiftStatus(svError, 'ID не отримано');
          end;
        end
        else
        begin
          Log('На касі немає відкритої зміни (ShiftStatus=' + CRStatus.ShiftStatus + ')');
          UpdateShiftStatus(svClosed, 'Не знайдена');
        end;
      end
      else
      begin
        Log('Не вдалося отримати статус каси: ' + AuthResponse);
        UpdateShiftStatus(svClosed, 'Не знайдена');
      end;
    finally
      if Assigned(CRStatus) then
        FreeAndNil(CRStatus);
    end;
  end
  else if (ShiftId = '') and (FReceiptAPI.CurrentShiftId = '') then
  begin
    Log('Збережена зміна не знайдена');
    UpdateShiftStatus(svClosed, 'Не знайдена');
  end;

  // Активація кнопок після recovery
  if FReceiptAPI.CurrentShiftId <> '' then
  begin
    btnCloseShiftSimpleCurl.Enabled := True;
    Log('Інтерфейс налаштовано для роботи зі зміною');
  end;

  // Автоперехід на потрібну вкладку після ініціалізації
  if Assigned(FReceiptAPI) and FReceiptAPI.IsTokenValid and
     (FReceiptAPI.CurrentCashRegisterId <> '') then
  begin
    if FReceiptAPI.CurrentShiftId = '' then
    begin
      // Все ОК, але зміна не відкрита → вкладка зміни
      if Assigned(PageControl1) and Assigned(tsShift) and tsShift.TabVisible then
      begin
        PageControl1.ActivePage := tsShift;
        Log('Зміна не відкрита → перехід на вкладку "Зміна"');
      end;
    end
    else
    begin
      // Все ОК і зміна відкрита → вкладка серійних номерів
      if Assigned(PageControl1) and Assigned(tsSerijnik) and tsSerijnik.TabVisible then
      begin
        PageControl1.ActivePage := tsSerijnik;
        Log('Зміна відкрита → перехід на вкладку "Серійні номери"');
      end;
    end;
  end;
  UpdateOfflineButtonsState;  // E3.1: узгодити стан кнопок «Офлайн»/«Онлайн» з БД
  UpdateAllStatuses;
end;

function TFmChek.ValidatePaymentFields: Boolean;
var
  SubType: Integer;
  PaymentType: string;
begin
  Result := False;

  // Читаємо тип оплати з QChek (DB-aware вже синхронізовані)
  PaymentType := Trim(UpperCase(DMMag.QChekPAYMENT_TYPE.AsString));

  if PaymentType = '' then
  begin
    Log('⚠️ ValidatePaymentFields: тип оплати не вказано');
    // Не помилка — може бути за замовчуванням CASH
    PaymentType := 'CASH';
  end;

  // Валідація тільки для безготівкових типів
  if PaymentType = 'CASHLESS' then
  begin
    SubType := DMMag.QChekPAYMENT_SUBTYPE.AsInteger;

    // Валідація залежно від підтипу
    case SubType of
      1, 3: // Картка, Інтернет еквайринг
        begin
          if (DMMag.QChekCARD_MASK.AsString <> '') and
             not ValidateCardMask(DMMag.QChekCARD_MASK.AsString) then
          begin
            ShowMessage('Невірна маска картки. Формат: ****1234 або 1234' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
          if (DMMag.QChekAUTH_CODE.AsString <> '') and
             not ValidateAuthCode(DMMag.QChekAUTH_CODE.AsString) then
          begin
            ShowMessage('Код авторизації — 6 цифр' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
          if (DMMag.QChekRRN.AsString <> '') and
             not ValidateRRN(DMMag.QChekRRN.AsString) then
          begin
            ShowMessage('RRN — 12 цифр' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
        end;

      2: // Інтернет-банкінг
        begin
          if (DMMag.QChekIBAN.AsString <> '') and
             not ValidateIBAN(DMMag.QChekIBAN.AsString) then
          begin
            ShowMessage('IBAN має формат UA + 27 цифр (29 символів)' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
        end;

      4..8: // Інтегратори
        begin
          if (DMMag.QChekAUTH_CODE.AsString <> '') and
             not ValidateAuthCode(DMMag.QChekAUTH_CODE.AsString) then
          begin
            ShowMessage('Код авторизації — 6 цифр' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
          if (DMMag.QChekRRN.AsString <> '') and
             not ValidateRRN(DMMag.QChekRRN.AsString) then
          begin
            ShowMessage('RRN — 12 цифр' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
        end;

      9: // Подарунковий сертифікат
        begin
          if (DMMag.QChekCARD_MASK.AsString <> '') and
             not ValidateCardMask(DMMag.QChekCARD_MASK.AsString) then
          begin
            ShowMessage('Невірний номер сертифіката' + sLineBreak +
                        'Перевірте та виправте поле вручну.');
            Exit;
          end;
        end;
    end;
  end;

  Result := True;
end;


function TFmChek.IsCashlessSubTypeNeedingDetails(SubType: Integer): Boolean;
begin
  // Чи потрібні додаткові поля для підтипу
  Result := SubType in [1, 2, 3, 4, 5, 6, 7, 8, 9];
end;


function TFmChek.IsTaxGroupValid(TaxGroup: Integer): Boolean;
const
  ValidTaxGroups: array[0..6] of Integer = (1, 2, 3, 4, 5,8, 99);
var
  i: Integer;
begin
  Result := False;
  for i := Low(ValidTaxGroups) to High(ValidTaxGroups) do
    if ValidTaxGroups[i] = TaxGroup then
    begin
      Result := True;
      Break;
    end;
end;


procedure TFmChek.UpdatePaymentControlsVisibility;
var
  PaymentType: string;
  SubType: Integer;
begin
  if not DMMag.QChek.Active or DMMag.QChek.IsEmpty or DMMag.QChekPAYMENT_TYPE.IsNull then
  begin
    lblSubType.Visible := False;
    cmbCashlessSubType.Visible := False;
    lblCashAmount.Visible := False;
    dbeCashAmount.Visible := False;
    lblCardAmount.Visible := False;
    dbeCardAmount.Visible := False;
    gbPaymentDetails.Visible := False;
    Exit;
  end;

  // БЕЗ UpperCase — порівнюємо точні українські назви з ChekTypes
  PaymentType := Trim(DMMag.QChekPAYMENT_TYPE.AsString);

  case PaymentType of
    'Готівка':
      begin
        lblSubType.Visible := False;
        cmbCashlessSubType.Visible := False;
        lblCashAmount.Visible := False;
        dbeCashAmount.Visible := False;
        lblCardAmount.Visible := False;
        dbeCardAmount.Visible := False;
        gbPaymentDetails.Visible := False;
      end;

    'Безготівковий':
      begin
        lblSubType.Visible := True;
        cmbCashlessSubType.Visible := True;
        lblCashAmount.Visible := False;
        dbeCashAmount.Visible := False;
        lblCardAmount.Visible := False;
        dbeCardAmount.Visible := False;
        gbPaymentDetails.Visible := True;

        // ВИПРАВЛЕНО: беремо integer-код, а не varchar
        SubType := DMMag.QChekPAYMENT_SUBTYPE_I.AsInteger;

        lblCardMask.Visible     := SubType in [1, 3, 9];
        edtCardMask.Visible     := SubType in [1, 3, 9];
        lblAuthCode.Visible     := SubType in [1, 3, 4, 5, 6, 7, 8];
        edtAuthCode.Visible     := SubType in [1, 3, 4, 5, 6, 7, 8];
        lblRRN.Visible          := SubType in [1, 3, 4, 5, 6, 7, 8];
        edtRRN.Visible          := SubType in [1, 3, 4, 5, 6, 7, 8];
        lblProvider.Visible     := SubType in [1, 3];
        cmbProvider.Visible     := SubType in [1, 3];
        lblIBAN.Visible         := SubType = 2;
        edtIBAN.Visible         := SubType = 2;
        lblRecipient.Visible    := SubType = 2;
        edtRecipientName.Visible:= SubType = 2;
        lblPurpose.Visible      := SubType = 2;
        memPaymentPurpose.Visible := SubType = 2;
      end;

    'Змішана':
      begin
        lblSubType.Visible := True;
        cmbCashlessSubType.Visible := True;
        lblCashAmount.Visible := True;
        dbeCashAmount.Visible := True;
        lblCardAmount.Visible := True;
        dbeCardAmount.Visible := True;
        gbPaymentDetails.Visible := True;
      end;

    'Інше':
      begin
        lblSubType.Visible := False;
        cmbCashlessSubType.Visible := False;
        lblCashAmount.Visible := False;
        dbeCashAmount.Visible := False;
        lblCardAmount.Visible := False;
        dbeCardAmount.Visible := False;
        gbPaymentDetails.Visible := False;
      end;
  else
    // Невідомий / старий англійський тип (CASH, CASHLESS…)
    lblSubType.Visible := False;
    cmbCashlessSubType.Visible := False;
    lblCashAmount.Visible := False;
    dbeCashAmount.Visible := False;
    lblCardAmount.Visible := False;
    dbeCardAmount.Visible := False;
    gbPaymentDetails.Visible := False;
  end;
end;

procedure TFmChek.DSChekDataChange(Sender: TObject; Field: TField);
begin
  // Захист від рекурсивних викликів
  if FUpdatingFromDataChange then
  begin
    Log('⚠️ DSChekDataChange: пропущено (рекурсія)');
    Exit;
  end;

  // Перевірка активності та стану набору даних
  if not DMMag.QChek.Active then
  begin
    Log('⚠️ DSChekDataChange: QChek не активний');
    Exit;
  end;

  // Якщо набір даних порожній — очищаємо UI
  if DMMag.QChek.IsEmpty then
  begin
    UpdatePaymentControlsVisibility;
    Exit;
  end;

  // Якщо запис в режимі вставки, але NOMER не заповнено — не оновлюємо UI, щоб уникнути помилок
  if (DMMag.QChek.State = dsInsert) and DMMag.QChekNOMER.IsNull then
  begin
    Log('⚠️ DSChekDataChange: пропущено (новий запис без NOMER)');
    Exit;
  end;

  // Якщо запис в режимі редагування або вставки, і змінюється PAYMENT_TYPE або PAYMENT_SUBTYPE,
  // то оновлюємо видимість, але не оновлюємо інші частини UI
  if DMMag.QChek.State in [dsEdit, dsInsert] then
  begin
    if Assigned(Field) and ((Field.FieldName = 'PAYMENT_TYPE') or (Field.FieldName = 'PAYMENT_SUBTYPE')) then
    begin
      FUpdatingFromDataChange := True;
      try
        Log('🔄 DSChekDataChange: оновлення видимості оплати (редагування)');
        UpdatePaymentControlsVisibility;
      finally
        FUpdatingFromDataChange := False;
      end;
    end;
    Exit; // Для інших полів або станів редагування не виконуємо інші дії
  end;

  // Пропускаємо якщо йде оновлення типу оплати програмно
  if FUpdatingPaymentType then
  begin
    Log('⚠️ DSChekDataChange: пропущено (оновлення типу оплати)');
    Exit;
  end;

  // При зміні конкретного поля — оновлюємо тільки якщо це релевантне поле
  if Assigned(Field) and (Field.FieldName <> 'PAYMENT_TYPE') and
     (Field.FieldName <> 'PAYMENT_SUBTYPE') and
     (Field.FieldName <> 'CASH_AMOUNT') and
     (Field.FieldName <> 'CARD_AMOUNT') then
    Exit;

  // Блокуємо повторний вхід – тепер із finally
  FUpdatingFromDataChange := True;
  try
    try
      Log('🔄 DSChekDataChange: оновлення UI для чека ' + DMMag.QChekKOD.AsString);

      // Оновлюємо видимість контролів залежно від типу оплати
      UpdatePaymentControlsVisibility;

      // Оновлення інформації про суму (для змішаної оплати)
      if DMMag.QChekPAYMENT_TYPE.AsString = 'MIXED' then
        lblSumInfo.Caption := Format('Готівка: %.2f, Картка: %.2f, Всього: %.2f',
          [DMMag.QChekCASH_AMOUNT.AsFloat, DMMag.QChekCARD_AMOUNT.AsFloat,
           DMMag.QChekSUMMA.AsFloat])
      else
        lblSumInfo.Caption := '';

    except
      on E: Exception do
      begin
        Log('❌ Помилка в DSChekDataChange: ' + E.Message);
      end;
    end;
  finally
    FUpdatingFromDataChange := False;
  end;
end;


procedure TFmChek.FillPaymentsFromInfo(Receipt: TReceipt; const PayInfo: TPaymentInfo);
var
  PaymentType: string;
  SubType: Integer;
  CashAmountCents, CardAmountCents: Integer;
  i: Integer;
begin
  PaymentType := PaymentTypeCodeToAPI(PayInfo.PaymentTypeCode);
  SubType := PayInfo.SubTypeCode;
  CashAmountCents := Round(PayInfo.CashAmount * 100);
  CardAmountCents := Round(PayInfo.CardAmount * 100);

  SetLength(Receipt.Payments, 0);

  // --- Готівковий платіж ---
  if CashAmountCents > 0 then
  begin
    SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
    i := High(Receipt.Payments);
    Receipt.Payments[i] := FReceiptAPI.CreatePayment(ptaCash, CashAmountCents);
    Receipt.Payments[i].LabelText := 'Готівка';
    Log('✅ Готівка: ' + FloatToStrF(CashAmountCents / 100, ffNumber, 10, 2) + ' грн');
  end;

  // --- Безготівковий платіж ---
  if CardAmountCents > 0 then
  begin
    if (PaymentType = 'CASHLESS') or (PaymentType = 'CARD') or (PaymentType = 'MIXED') then
    begin
      if SubType = 0 then
      begin
        Log('⚠️ Підтип оплати = 0, встановлено за замовчуванням: картка (1)');
        SubType := 1;
      end;

      case SubType of
        1, 3, 9:  // Картка, Інтернет еквайринг, Подарунковий сертифікат
          begin
            SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
            i := High(Receipt.Payments);
            Receipt.Payments[i] := FReceiptAPI.CreateCashlessPayment(CardAmountCents, TCashlessSubType(SubType));
            if (SubType >= Low(CashlessSubTypeUI_Names)) and (SubType <= High(CashlessSubTypeUI_Names)) then
              Receipt.Payments[i].LabelText := CashlessSubTypeUI_Names[SubType]
            else
              Receipt.Payments[i].LabelText := 'Безготівка (підтип ' + IntToStr(SubType) + ')';

            // ✅ НОВЕ: Додаємо реквізити з PayInfo
            Receipt.Payments[i].CardMask := PayInfo.CardMask;
            Receipt.Payments[i].AuthCode := PayInfo.AuthCode;
            Receipt.Payments[i].RRN := PayInfo.RRN;

            Log('✅ ' + Receipt.Payments[i].LabelText);
          end;

        2: // Інтернет-банкінг (IBAN, Recipient, Purpose)
          begin
            SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
            i := High(Receipt.Payments);
            Receipt.Payments[i] := FReceiptAPI.CreateInternetBankingPayment(
              CardAmountCents,
              PayInfo.IBAN,
              PayInfo.RecipientName,
              PayInfo.PaymentPurpose
            );
            Receipt.Payments[i].LabelText := 'Інтернет банкінг';
            Log('✅ Інтернет-банкінг (IBAN: ' + Copy(PayInfo.IBAN, 1, 10) + '...)');
          end;

        4..8: // Інтегратори (LiqPay, Mono, WayForPay, NovaPay, EasyPay)
          begin
            SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
            i := High(Receipt.Payments);
            Receipt.Payments[i] := FReceiptAPI.CreateIntegratorPayment(CardAmountCents, PayInfo.ProviderAPI);
            // ✅ ВИПРАВЛЕНО: Видалено ручне присвоєння LabelText — CreateIntegratorPayment
            // встановлює його автоматично відповідно до Наказу №601
            Log('✅ Інтегратор: ' + PayInfo.ProviderAPI);
          end;

        10..17: // Талон, перекази, рахунок, електронні/цифрові гроші, криптовалюта, інше
          begin
            SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
            i := High(Receipt.Payments);
            Receipt.Payments[i] := FReceiptAPI.CreateCashlessPayment(
              CardAmountCents, TCashlessSubType(SubType));
            if (SubType >= Low(CashlessSubTypeUI_Names)) and
               (SubType <= High(CashlessSubTypeUI_Names)) then
              Receipt.Payments[i].LabelText := CashlessSubTypeUI_Names[SubType]
            else
              Receipt.Payments[i].LabelText := 'Безготівка (підтип ' + IntToStr(SubType) + ')';
            Log('✅ ' + Receipt.Payments[i].LabelText);
          end;

        else
          // невідомий підтип – картка за замовчуванням
          begin
            SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
            i := High(Receipt.Payments);
            Receipt.Payments[i] := FReceiptAPI.CreateCashlessPayment(CardAmountCents, cstCard);
            Receipt.Payments[i].LabelText := 'Картка';
            Log('⚠️ Невідомий підтип ' + IntToStr(SubType) + ', використано картку');
          end;
      end;
    end
    else if PaymentType = 'OTHER' then
    begin
      SetLength(Receipt.Payments, Length(Receipt.Payments) + 1);
      i := High(Receipt.Payments);
      Receipt.Payments[i] := FReceiptAPI.CreatePayment(ptaOther, CardAmountCents);
      Receipt.Payments[i].LabelText := 'Інше';
      Log('✅ Інше');
    end
    else
    begin
      Log('⚠️ Невідомий тип оплати: "' + PaymentType + '", ігноруємо безготівкову частину');
    end;
  end;

  // --- Розрахунок загальних сум ---
  Receipt.TotalPayment := 0;
  for i := 0 to High(Receipt.Payments) do
    if Assigned(Receipt.Payments[i]) then
      Receipt.TotalPayment := Receipt.TotalPayment + Receipt.Payments[i].Value;

  Receipt.Rest := Receipt.TotalPayment - Receipt.TotalSum;

  // Валідація та корекція
  if Receipt.TotalPayment < Receipt.TotalSum then
  begin
    Log('❌ Сума оплат (' + FloatToStrF(Receipt.TotalPayment/100, ffNumber, 10, 2) +
        ') менша за суму чека (' + FloatToStrF(Receipt.TotalSum/100, ffNumber, 10, 2) + ')');
    raise Exception.CreateFmt(
      'Сума оплат (%.2f грн) менша за суму чека (%.2f грн). Додайте оплату.',
      [Receipt.TotalPayment / 100, Receipt.TotalSum / 100]);
  end
  else if Receipt.TotalPayment > Receipt.TotalSum then
  begin
    Log('⚠️ Сума оплат (' + FloatToStrF(Receipt.TotalPayment/100, ffNumber, 10, 2) +
        ') більша за суму чека (' + FloatToStrF(Receipt.TotalSum/100, ffNumber, 10, 2) +
        '). Коригуємо перший платіж...');
    if Length(Receipt.Payments) > 0 then
    begin
      Receipt.Payments[0].Value := Receipt.Payments[0].Value -
                                   (Receipt.TotalPayment - Receipt.TotalSum);
      Receipt.TotalPayment := Receipt.TotalSum;
      Receipt.Rest := 0;
      Log('✅ Суми скориговано');
    end;
  end;

  Log('--- Підсумки оплат ---');
  Log('TotalSum: ' + IntToStr(Receipt.TotalSum) + ' коп');
  Log('TotalPayment: ' + IntToStr(Receipt.TotalPayment) + ' коп');
  Log('Rest: ' + IntToStr(Receipt.Rest) + ' коп');
  Log('Кількість платежів: ' + IntToStr(Length(Receipt.Payments)));
end;


procedure TFmChek.DiagnoseReceipt(AReceipt: TReceipt);
var
  I: Integer;
  HasMixed: Boolean;
begin
  HasMixed := False;

  // 1. Перевірка ptaMixed
  for I := 0 to High(AReceipt.Payments) do
    if Assigned(AReceipt.Payments[I]) and (AReceipt.Payments[I].PaymentType = ptaMixed) then
      HasMixed := True;

  if HasMixed then
    raise Exception.Create('[CRITICAL] Знайдено ptaMixed. Розбийте на ptaCash + ptaCashless!');

  // 2. Перевірка RETURN
  if (AReceipt.ReceiptType = rtReturn) and (AReceipt.RelatedReceiptId = '') then
    raise Exception.Create('[CRITICAL] Чек RETURN без RelatedReceiptId!');

  // 3. Перевірка rounding
  if AReceipt.RoundingSum <> 0 then
    ShowMessage('RoundingSum = ' + IntToStr(AReceipt.RoundingSum) + ' коп');

  // 4. Перевірка label інтеграторів
  for I := 0 to High(AReceipt.Payments) do
    if Assigned(AReceipt.Payments[I]) and (AReceipt.Payments[I].PaymentType = ptaCashless) then
    begin
      if AReceipt.Payments[I].LabelText = 'Mono' then
        raise Exception.Create('[CRITICAL] Старий label "Mono". Використайте CreateIntegratorPayment!');
      if AReceipt.Payments[I].LabelText = 'LiqPay' then
        raise Exception.Create('[CRITICAL] Старий label "LiqPay". Використайте CreateIntegratorPayment!');
    end;

  Log('Діагностика чека пройдена успішно');
end;

procedure TFmChek.CashCardExit(Sender: TObject);
var
  PaymentType: string;
  CashAmt, CardAmt, Summa: Double;
  CheckID: Integer;
begin
  // Захист від рекурсії
  if FUpdatingPaymentType or FUpdatingFromDataChange then Exit;

  if not DMMag.QChek.Active or DMMag.QChek.IsEmpty then Exit;

  CheckID := DMMag.QChekKOD.AsInteger;
  if CheckID <= 0 then Exit;

  // Суми вже оновлені через DataAware, читаємо з датасету
  PaymentType := Trim(DMMag.QChekPAYMENT_TYPE.AsString);
  CashAmt := DMMag.QChekCASH_AMOUNT.AsFloat;
  CardAmt := DMMag.QChekCARD_AMOUNT.AsFloat;
  Summa   := DMMag.QChekSUMMA.AsFloat;

  // Валідація тільки для змішаної оплати
  if PaymentType = 'Змішана' then
  begin
    if (CashAmt <= 0) or (CardAmt <= 0) then
    begin
      ShowMessage('Для змішаної оплати обидві суми мають бути > 0.' + sLineBreak +
                  Format('Зараз: готівка=%.2f, картка=%.2f', [CashAmt, CardAmt]));
      Exit;
    end;
    if Abs(CashAmt + CardAmt - Summa) > 0.01 then
    begin
      ShowMessage(Format(
        'Готівка (%.2f) + Картка (%.2f) ≠ Сума чека (%.2f).',
        [CashAmt, CardAmt, Summa]));
      Exit;
    end;
  end;

  // Збереження в БД
  FUpdatingPaymentType := True;
  try
    FDBManager.UpdatePaymentInfo(
      CheckID,
      PaymentType,
      CashAmt,
      CardAmt,
      DMMag.QChekPAYMENT_SUBTYPE.AsString,
      DMMag.QChekIBAN.AsString,
      DMMag.QChekRECIPIENT_NAME.AsString,
      DMMag.QChekPAYMENT_PURPOSE.AsString,
      DMMag.QChekCARD_MASK.AsString,
      DMMag.QChekAUTH_CODE.AsString,
      DMMag.QChekRRN.AsString,
      DMMag.QChekPROVIDER_TYPE.AsString,
      ''
    );
    if DMMag.QChek.State in [dsEdit, dsInsert] then
      DMMag.QChek.Cancel;
    Log(Format('💰 Суми оплати в БД: готівка=%.2f, картка=%.2f', [CashAmt, CardAmt]));
  finally
    FUpdatingPaymentType := False;
  end;
end;

