  begin
    ShiftId := FReceiptAPI.CurrentShiftId; // Це має бути ID, не Serial
    if ShiftId = '' then
      ShiftId := FReceiptAPI.LoadShiftFromFile; // Має повертати ID
    if ShiftId = '' then
    begin
      ShowMessage('Немає активної зміни.');
      Exit;
    end;
    SynchronizeShiftId(ShiftId); // Синхронізуємо всі джерела
  end;

  // Перевіряємо ID, а не Serial
  if not ValidateShiftId(ShiftId) then
  begin
    ShowMessage('Недійсний ID зміни');
    Exit;
  end;

  Log('Перевірка статусу зміни через CURL...');
  Log('Shift ID: ' + ShiftId);

  Success := FReceiptAPI.GetShiftStatusCurl(ShiftId, Response, ShiftStatus);

  if Success and Assigned(ShiftStatus) then
  begin
    Log('Статус зміни отримано через CURL!');
    Log('ID: ' + ShiftStatus.Id);
    Log('Статус: ' + ShiftStatus.Status);
    Log('Серійний номер: ' + IntToStr(ShiftStatus.Serial));
    Log('Z-звіт: ' + ShiftStatus.ZReport);

    if ShiftStatus.Status = 'OPENED' then
    begin
      Log('Зміна відкрита о: ' + DateTimeToStr(ShiftStatus.OpenedAt));
      // Оновлюємо інтерфейс для відкритої зміни
      btnCloseShiftSimpleCurl.Enabled := True;
      btnCloseShiftWithReportCurl.Enabled := True;
    end
    else if ShiftStatus.Status = 'CLOSED' then
    begin
      Log('Зміна закрита о: ' + DateTimeToStr(ShiftStatus.ClosedAt));
      // Додаткова інформація про причину закриття (якщо є)
      if ShiftStatus.EmergencyClose then
      begin
        Log('Аварійне закриття: ' + ShiftStatus.EmergencyCloseDetails);
      end;

      // Деактивуємо кнопки закриття для закритої зміни
      btnCloseShiftSimpleCurl.Enabled := False;
      btnCloseShiftWithReportCurl.Enabled := False;
    end;

    // Додаткова інформація про касу
    if ShiftStatus.CashRegisterId <> '' then
    begin
      Log('ID каси: ' + ShiftStatus.CashRegisterId);
    end;

    // Оновлюємо поле вводу з правильним ID
    if ShiftStatus.Id <> '' then
    begin
      SynchronizeShiftId(ShiftStatus.Id);
    end;

    // Показуємо статус користувачеві
    case ShiftStatus.Status of
      'OPENED':
       begin
        UpdateShiftStatus(svOpened, '№' + IntToStr(ShiftStatus.Serial));
        Log('Зміна відкрита' + sLineBreak +
                   'Номер: ' + IntToStr(ShiftStatus.Serial) + sLineBreak +
                   'Відкрита: ' + DateTimeToStr(ShiftStatus.OpenedAt));
       end;
      'CLOSED':
       begin
        UpdateShiftStatus(svClosed, '№' + IntToStr(ShiftStatus.Serial));
        Log('Зміна закрита' + sLineBreak +
                   'Номер: ' + IntToStr(ShiftStatus.Serial) + sLineBreak +
                   'Закрита: ' + DateTimeToStr(ShiftStatus.ClosedAt));
       end
      else
        begin
         UpdateShiftStatus(svError, ShiftStatus.Status);
         Log('Статус зміни: ' + ShiftStatus.Status + sLineBreak +
                   'Номер: ' + IntToStr(ShiftStatus.Serial));
        end;
    end;

  end
  else
  begin
    Log('Помилка отримання статусу зміни через CURL: ' + Response);

    // Детальніша обробка помилок
    if Pos('"message":"', Response) > 0 then
      Log('Сервер повернув помилку: ' + Response)
    else if Pos('Not Found', Response) > 0 then
      Log('Зміну не знайдено. Перевірте ID зміни.')
    else if Pos('Unauthorized', Response) > 0 then
      Log('Помилка авторизації. Токен недійсний.');

    ShowMessage('Помилка отримання статусу зміни через CURL: ' + Copy(Response, 1, 200));
  end;
  UpdateAllStatuses;
  if Assigned(ShiftStatus) then
    FreeAndNil(ShiftStatus);
end;

procedure TFmChek.btnGetXReportClick(Sender: TObject);
var
  LResponse: string;
  LShiftReport: TShiftReport;
  LTextReport: string;
  LReportFile: string;
  LPngFileName: string;
  I: Integer; // Додано оголошення змінної I

  // Функція повинна бути оголошена перед використанням
  function GenerateXReportText(LShiftReport: TShiftReport): string;
  var
    J: Integer; // Використовуємо іншу змінну для уникнення конфлікту
    LText: TStringList;
  begin
    LText := TStringList.Create;
    try
      // Заголовок
      LText.Add('═══════════════════════════════════════════════════');
      LText.Add('                   Х-ЗВІТ');
      LText.Add('═══════════════════════════════════════════════════');
      LText.Add('');

      // Основна інформація
      LText.Add('▸ ID звіту: ' + LShiftReport.Id);
      LText.Add('▸ Серійний номер: ' + IntToStr(LShiftReport.Serial));
      LText.Add('▸ Час створення: ' + DateTimeToStr(LShiftReport.CreatedAt));
      LText.Add('');

      // Статистика чеків
      LText.Add('────────────── СТАТИСТИКА ЧЕКІВ ──────────────');
      LText.Add('Чеків продажу:        ' + IntToStr(LShiftReport.SellReceiptsCount));
      LText.Add('Чеків повернення:     ' + IntToStr(LShiftReport.ReturnReceiptsCount));
      LText.Add('Чеків видачі готівки: ' + IntToStr(LShiftReport.CashWithdrawalReceiptsCount));
      LText.Add('');

      // Фінансові підсумки
      LText.Add('───────────────── ФІНАНСИ ───────────────────');
      LText.Add('Початкова сума:       ' + FormatFloat('0.00', LShiftReport.Initial / 100) + ' грн');
      LText.Add('Кінцевий баланс:      ' + FormatFloat('0.00', LShiftReport.Balance / 100) + ' грн');
      LText.Add('Сума знижок:          ' + FormatFloat('0.00', LShiftReport.DiscountsSum / 100) + ' грн');
      LText.Add('Сума націнок:         ' + FormatFloat('0.00', LShiftReport.ExtraChargeSum / 100) + ' грн');
      LText.Add('');

      // Округлення
      LText.Add('──────────────── ОКРУГЛЕННЯ ─────────────────');
      LText.Add('Продажі (вгору):      ' + FormatFloat('0.00', LShiftReport.SalesRoundUp / 100) + ' грн');
      LText.Add('Продажі (вниз):       ' + FormatFloat('0.00', LShiftReport.SalesRoundDown / 100) + ' грн');
      LText.Add('Повернення (вгору):   ' + FormatFloat('0.00', LShiftReport.ReturnsRoundUp / 100) + ' грн');
      LText.Add('Повернення (вниз):    ' + FormatFloat('0.00', LShiftReport.ReturnsRoundDown / 100) + ' грн');
      LText.Add('');

      // Платежі
      if Length(LShiftReport.Payments) > 0 then
      begin
        LText.Add('───────────────── ПЛАТЕЖІ ───────────────────');
        for J := 0 to High(LShiftReport.Payments) do
        begin
          LText.Add('● ' + LShiftReport.Payments[J].LabelText + ':');
          LText.Add('  Продажі:    ' + FormatFloat('0.00', LShiftReport.Payments[J].SellSum / 100) + ' грн');
          LText.Add('  Повернення: ' + FormatFloat('0.00', LShiftReport.Payments[J].ReturnSum / 100) + ' грн');
          if LShiftReport.Payments[J].ServiceIn > 0 then
            LText.Add('  Service In: ' + FormatFloat('0.00', LShiftReport.Payments[J].ServiceIn / 100) + ' грн');
          if LShiftReport.Payments[J].ServiceOut > 0 then
            LText.Add('  Service Out:' + FormatFloat('0.00', LShiftReport.Payments[J].ServiceOut / 100) + ' грн');
          LText.Add('');
        end;
      end;

      // Податки
      if Length(LShiftReport.Taxes) > 0 then
      begin
        LText.Add('───────────────── ПОДАТКИ ───────────────────');
        for J := 0 to High(LShiftReport.Taxes) do
        begin
          if (LShiftReport.Taxes[J].SalesTurnover > 0) or (LShiftReport.Taxes[J].ReturnsTurnover > 0) then
          begin
            LText.Add('● ' + LShiftReport.Taxes[J].LabelText + ' (' + LShiftReport.Taxes[J].Symbol + '):');
            LText.Add('  Ставка:     ' + FormatFloat('0.0', LShiftReport.Taxes[J].Rate) + '%');
            LText.Add('  Оборот:     ' + FormatFloat('0.00', LShiftReport.Taxes[J].SalesTurnover / 100) + ' грн');
            if LShiftReport.Taxes[J].ReturnsTurnover > 0 then
              LText.Add('  Повернення: ' + FormatFloat('0.00', LShiftReport.Taxes[J].ReturnsTurnover / 100) + ' грн');
            LText.Add('');
          end;
        end;
      end;

      LText.Add('═══════════════════════════════════════════════════');
      LText.Add('             ЗВІТ СФОРМОВАНО УСПІШНО');
      LText.Add('═══════════════════════════════════════════════════');

      Result := LText.Text;
    finally
      LText.Free;
    end;
  end;

begin
  // ✅ ВИПРАВЛЕНО: Для X-звіту тепер обов'язкова авторизація (v112)
  if not ValidateAPIState(True, False) then Exit;

  // ВИПРАВЛЕННЯ: Для X-звіту не потрібен ShiftId - він створюється для поточної відкритої зміни
  // Отримуємо Х-звіт через API
  if FReceiptAPI.GetShiftXReportCurl('', LResponse, LShiftReport) then // Порожній ShiftId - для поточної зміни
  begin
    try
      // Виводимо основні дані звіту
      Log('=== Х-ЗВІТ ===');
      Log('ID звіту: ' + LShiftReport.Id);
      Log('Серійний номер: ' + IntToStr(LShiftReport.Serial));
      Log('Чеків продажу: ' + IntToStr(LShiftReport.SellReceiptsCount));
      Log('Чеків повернення: ' + IntToStr(LShiftReport.ReturnReceiptsCount));
      Log('Чеків видачі готівки: ' + IntToStr(LShiftReport.CashWithdrawalReceiptsCount));
      Log('Початкова сума: ' + FloatToStr(LShiftReport.Initial / 100) + ' грн');
      Log('Баланс: ' + FloatToStr(LShiftReport.Balance / 100) + ' грн');
      Log('Останній ID чека: ' + LShiftReport.LastReceiptId);
      Log('Округлення продажів у більшу сторону: ' + FloatToStr(LShiftReport.SalesRoundUp / 100) + ' грн');
      Log('Округлення продажів у меншу сторону: ' + FloatToStr(LShiftReport.SalesRoundDown / 100) + ' грн');
      Log('Округлення повернень у більшу сторону: ' + FloatToStr(LShiftReport.ReturnsRoundUp / 100) + ' грн');
      Log('Округлення повернень у меншу сторону: ' + FloatToStr(LShiftReport.ReturnsRoundDown / 100) + ' грн');

      // ВИПРАВЛЕННЯ: Додаємо нові поля згідно документації
      Log('Сума знижок: ' + FloatToStr(LShiftReport.DiscountsSum / 100) + ' грн');
      Log('Сума націнок: ' + FloatToStr(LShiftReport.ExtraChargeSum / 100) + ' грн');

      Log('Дата створення: ' + DateTimeToStr(LShiftReport.CreatedAt));

      // Виводимо інформацію про платежі
      if Length(LShiftReport.Payments) > 0 then
      begin
        Log('--- ПЛАТЕЖІ ---');
        for I := 0 to High(LShiftReport.Payments) do
        begin
          Log('Платіж ' + IntToStr(I+1) + ':');
          Log('  Тип: ' + LShiftReport.Payments[I].PaymentType);
          Log('  Постачальник: ' + LShiftReport.Payments[I].ProviderType);
          Log('  Код: ' + IntToStr(LShiftReport.Payments[I].Code));
          Log('  Назва: ' + LShiftReport.Payments[I].LabelText);
          Log('  Сума продажів: ' + FloatToStr(LShiftReport.Payments[I].SellSum / 100) + ' грн');
          Log('  Сума повернень: ' + FloatToStr(LShiftReport.Payments[I].ReturnSum / 100) + ' грн');
          Log('  Service In: ' + FloatToStr(LShiftReport.Payments[I].ServiceIn / 100) + ' грн');
          Log('  Service Out: ' + FloatToStr(LShiftReport.Payments[I].ServiceOut / 100) + ' грн');
          Log('  Видача готівки: ' + FloatToStr(LShiftReport.Payments[I].CashWithdrawal / 100) + ' грн');
          Log('  Комісія видачі: ' + FloatToStr(LShiftReport.Payments[I].CashWithdrawalCommission / 100) + ' грн');
        end;
      end
      else
      begin
        Log('--- ПЛАТЕЖІ: Немає даних ---');
      end;

      // Виводимо інформацію про податки
      if Length(LShiftReport.Taxes) > 0 then
      begin
        Log('--- ПОДАТКИ ---');
        for I := 0 to High(LShiftReport.Taxes) do
        begin
          Log('Податок ' + IntToStr(I+1) + ':');
          Log('  ID: ' + LShiftReport.Taxes[I].Id);
          Log('  Код: ' + IntToStr(LShiftReport.Taxes[I].Code));
          Log('  Назва: ' + LShiftReport.Taxes[I].LabelText);
          Log('  Символ: ' + LShiftReport.Taxes[I].Symbol);
          Log('  Ставка: ' + FloatToStr(LShiftReport.Taxes[I].Rate) + '%');

          Log('  Сума продажів: ' + FloatToStr(LShiftReport.Taxes[I].SellSum / 100) + ' грн');
          Log('  Сума повернень: ' + FloatToStr(LShiftReport.Taxes[I].ReturnSum / 100) + ' грн');
          Log('  Оборот продажів: ' + FloatToStr(LShiftReport.Taxes[I].SalesTurnover / 100) + ' грн');
          Log('  Оборот повернень: ' + FloatToStr(LShiftReport.Taxes[I].ReturnsTurnover / 100) + ' грн');

          Log('  Без ПДВ: ' + BoolToStr(LShiftReport.Taxes[I].NoVat, True));
          Log('  Розширений код: ' + LShiftReport.Taxes[I].AdvancedCode);
          Log('  Дата налаштування: ' + DateTimeToStr(LShiftReport.Taxes[I].SetupDate));
        end;
      end
      else
      begin
        Log('--- ПОДАТКИ: Немає даних ---');
      end;

      Log('=== КІНЕЦЬ Х-ЗВІТУ ===');

      // Створюємо текстову версію звіту
      LTextReport := GenerateXReportText(LShiftReport);

      // Зберігаємо у файл
      LReportFile := IncludeTrailingPathDelimiter(receiptspath) +
                    'xreport_' + LShiftReport.Id + '_' +
                    FormatDateTime('yyyy-mm-dd_hh-nn-ss', Now) + '.txt';

      with TStringList.Create do
      try
        Text := LTextReport;
        SaveToFile(LReportFile);
        Log('✅ Текстовий звіт збережено: ' + ExtractFileName(LReportFile));
      finally
        Free;
      end;


      // === ВАРІАНТ 2: Офіційна текстова версія з API ===
      FReceiptAPI.ReceiptsDirectory := receiptspath;
      FReceiptAPI.TempDirectory := temppath;
      if FReceiptAPI.GetSummaryReportText(LShiftReport.Id, LResponse,rtXReport, 42) then // width=42
      begin
        Log('--- ОФІЦІЙНА ТЕКСТОВА ВЕРСІЯ Х-ЗВІТУ ---');
        Log(LResponse);
        Log('--- КІНЕЦЬ ОФІЦІЙНОЇ ВЕРСІЇ ---');
      end
      else
      begin
        Log('⚠️ Офіційна текстова версія недоступна: ' + FReceiptAPI.LastError);
        Log('ℹ️ Використовується власна текстова версія');
      end;

      // === ВАРІАНТ 3: PNG версія звіту ===
      LPngFileName := IncludeTrailingPathDelimiter(receiptspath) +
                    'xreport_' + LShiftReport.Id + '_' +
                    FormatDateTime('yyyy-mm-dd_hh-nn-ss', Now) + '.png';
      if FReceiptAPI.GetSummaryReportPNG(LShiftReport.Id, LPngFileName,rtXReport, 30, 58) then // width=30, paper_width=58
      begin
        Log('✅ PNG звіт отримано: ' + ExtractFileName(LPngFileName));
        ShowCheck(LPngFileName);
        if MessageDlg('Х-звіт', 'Надрукувати Х-звіт?',mtConfirmation, [mbYes, mbNo], 0) = mrYes then
        begin
          PrintCheckCustom(LPNGFileName,FPrinterName, FPageLeft, FPageTop, FPageWidth, FPageScale);
          Log('Х-звіт надіслано на друк');
        end;
        // Тут можна додати відображення зображення в інтерфейсі
        // Image1.Picture.LoadFromFile(LPngFileName);
      end
      else
      begin
        Log('⚠️ PNG версія звіту недоступна: ' + FReceiptAPI.LastError);
      end;

    finally
      if Assigned(LShiftReport) then
        LShiftReport.Free;
    end;
  end
  else
  begin
    Log('Помилка отримання Х-звіту: ' + LResponse);
  end;
end;

procedure TFmChek.btnGoOfflineClick(Sender: TObject);
var
  Response, Err, CR: string;
  ShiftStatus: TShiftStatus;
begin
  if not ValidateAPIState(False, True) then Exit;  // RequireCashRegister=True

  CR := FReceiptAPI.CurrentCashRegisterId;

  // === E3.1: розширена гілка при flag=1 ===
  if ReadOfflineModeEnabled then
  begin
    // Вже офлайн?
    if FDBManager.IsOfflineState(CR) then
    begin
      ShowMessage('Каса вже в офлайн-режимі.');
      UpdateOfflineButtonsState;
      Exit;
    end;

    // Ліміт 168 год (36 год — не перевіряємо, бо ми ще онлайн)
    if not FDBManager.CheckOfflineLimits(CR, Err) then
    begin
      Log('CheckOfflineLimits (go-offline) FAIL: ' + Err);
      ShowMessage('Перехід в офлайн заблоковано:' + sLineBreak + sLineBreak + Err);
      Exit;
    end;

    // Підтвердження
    if MessageDlg('Перехід в офлайн',
      'Після переходу в офлайн:' + sLineBreak +
      '  • Повернення та службові операції — недоступні' + sLineBreak +
      '  • Друк чека — лише після синхронізації' + sLineBreak +
      '  • Ліміти: 36 год безперервно / 168 год на місяць' + sLineBreak +
      '  • Продажі зберігатимуться в черзі' + sLineBreak + sLineBreak +
      'Продовжити?',
      mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;
  end;

  btnGoOffline.Enabled := False;
  Screen.Cursor := crHourGlass;
  ShiftStatus := nil;
  try
    try
      Log('=== ПЕРЕХІД В ОФЛАЙН ===');
      Log('ID каси: ' + CR);

      if not FReceiptAPI.GoOfflineCurl(Response) then
      begin
        // E3.1: already_offline — каса вже в офлайні на сервері. Не помилка.
        if Pos('already_offline', Response) > 0 then
        begin
          Log('ℹ️ API: already_offline — продовжуємо з локальним станом');
        end
        else
        begin
          Log('❌ GoOffline FAIL: ' + Copy(Response, 1, 200));
          ShowMessage('Помилка переходу в офлайн: ' + Copy(Response, 1, 200));
          Exit;
        end;
      end
      else
        Log('✅ API ok: ' + Copy(Response, 1, 200));

      // === flag=1: локальний стан + кеш балансу ===
      if ReadOfflineModeEnabled then
      begin
        if not FDBManager.UpdateOfflineStateStart(CR, Err) then
        begin
          Log('⚠️ API ok, але локальний стан не оновлено: ' + Err);
          ShowMessage('Каса переведена в офлайн на сервері,' + sLineBreak +
                      'але локальний стан не збережено:' + sLineBreak +
                      Copy(Err, 1, 300) + sLineBreak + sLineBreak +
                      'Рекомендується перевірити стан і повторити.');
        end
        else
        begin
          Log('✅ Локальний стан: IS_OFFLINE=1, OFFLINE_STARTED_AT=NOW');

          // Кеш балансу
          ShiftStatus := nil;
          if (FReceiptAPI.CurrentShiftId <> '') and
             FReceiptAPI.GetShiftStatusCurl(FReceiptAPI.CurrentShiftId,
                                            Response, ShiftStatus) and
             Assigned(ShiftStatus) and Assigned(ShiftStatus.Balance) then
          begin
            FDBManager.CacheBalance(CR,
              ShiftStatus.Balance.Balance / 100,
              ShiftStatus.Balance.CashSales / 100,
              ShiftStatus.Balance.CardSales / 100);
          end
          else
            Log('⚠️ CacheBalance пропущено (немає ShiftStatus/Balance)');

          if Assigned(ShiftStatus) then FreeAndNil(ShiftStatus);

          ShowMessage('✅ Каса переведена в офлайн-режим.' + sLineBreak +
                      sLineBreak +
                      'Подальші продажі зберігатимуться в черзі та будуть ' +
                      'надіслані при поверненні в онлайн.');
        end;
      end
      else
      begin
        // flag=0 — стара поведінка (без state tracking)
        Log('flag=0: локальний стан не оновлюється');
      end;
    except
      on E: Exception do
      begin
        Log('❌ Виняток go-offline: ' + E.Message);
        ShowMessage('Виникла помилка: ' + E.Message);
      end;
    end;
  finally
    if Assigned(ShiftStatus) then FreeAndNil(ShiftStatus);
    Screen.Cursor := crDefault;
    btnGetCashRegisterStatusCurl.Click;  // оновлення статусу каси (як раніше)
    UpdateOfflineButtonsState;
    UpdateOfflinePanels;
    UpdateAllStatuses;
    Log('=== КІНЕЦЬ ПЕРЕХОДУ В ОФЛАЙН ===');
  end;
end;

procedure TFmChek.btnGoOnlineClick(Sender: TObject);
var
  CR, SyncOwner: string;
  TimeoutMin: Integer;
  LockAcquired: Boolean;
begin
  if not ValidateAPIState(False, True) then Exit;

  CR := FReceiptAPI.CurrentCashRegisterId;
  if CR = '' then
  begin
    ShowMessage('ID каси не встановлено');
    Exit;
  end;

  // ===== E3.3.5: sync-гілка при flag=1 =====
  if ReadOfflineModeEnabled then
  begin
    if FSyncRunning then
    begin
      ShowMessage('Синхронізація вже виконується. Зачекайте завершення...');
      Exit;
    end;

    if MessageDlg('Перехід в онлайн',
      'Буде виконано:' + sLineBreak +
      '  1. Синхронізація черги офлайн-чеків' + sLineBreak +
      '  2. Перехід каси в онлайн' + sLineBreak + sLineBreak +
      'Продовжити?',
      mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;

    SyncOwner := FSyncOwner;
    TimeoutMin := ReadSyncLockTimeoutMin;

    btnGoOnline.Enabled := False;
    btnGoOffline.Enabled := False;
    Screen.Cursor := crHourGlass;

    LockAcquired := False;
    FSyncRunning := True;
    try
      try
        LockAcquired := FDBManager.TryAcquireLock(CR, SyncOwner, TimeoutMin);

        if not LockAcquired then
        begin
          Log('⚠️ Sync lock зайнято іншим процесом');
          ShowMessage('Синхронізація виконується на іншому терміналі.' + sLineBreak +
                      'Спробуйте пізніше (timeout ' + IntToStr(TimeoutMin) + ' хв).');
          Exit;
        end;

        // Sync inline
        RunSyncInline(CR, SyncOwner);
        ShowSyncReport;
      finally
        if LockAcquired then
          FDBManager.ReleaseLock(CR, SyncOwner);
        FSyncRunning := False;
        Screen.Cursor := crDefault;
        btnGoOnline.Enabled := True;
        btnGoOffline.Enabled := True;
      end;
    except
      on E: Exception do
      begin
        Log('💥 Sync exception: ' + E.Message);
        ShowMessage('Помилка синхронізації: ' + E.Message);
      end;
    end;

    // DoGoOnline
    DoGoOnline;
    Exit;
  end;

  // ===== flag=0 =====
  btnGoOnline.Enabled := False;
  Screen.Cursor := crHourGlass;
  try
    Log('Спроба переходу каси в онлайн режим (flag=0)...');
    Log('ID каси: ' + edtCashRegisterId.Text);
    DoGoOnline;
  finally
    Screen.Cursor := crDefault;
    UpdateOfflineButtonsState;
    UpdateAllStatuses;
  end;
end;

