    );

    Log('Створено екземпляр TReceiptWebAPI');

    // Виконуємо авторизацію через CURL
    Success := FReceiptAPI.LoginCurl(
      edtUsername.Text, // Ім'я користувача
      edtPassword.Text, // Пароль
      Response          // Відповідь сервера
    );

    if Success then
