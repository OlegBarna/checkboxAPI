procedure TFmChek.btnOpenShiftClick(Sender: TObject);
var
  Response: string;
  ShiftStatus: TShiftStatus;
  CRStatus: TCashRegisterStatus;
  ShiftInfo: string;          // текст для StatusBar (№Serial або порожньо)
  LocalShiftId: string;       // локальний ID до перевірки
  ScopeMismatch: Boolean;     // true, якщо локальний ID вказував на іншу касу
begin
  ShiftStatus := nil;
  CRStatus := nil;
  ShiftInfo := '';
  ScopeMismatch := False;

  // [SHIFT-GUARD] Якщо локально є ID — перевіряємо на сервері:
  //   (a) чи справді OPENED;
  //   (b) чи належить ВІН НАШІЙ касі (а не іншій на тому ж акаунті).
  LocalShiftId := '';
  if Assigned(FReceiptAPI) then
    LocalShiftId := FReceiptAPI.CurrentShiftId;

  if Assigned(FReceiptAPI) and (LocalShiftId <> '') then
  begin
    if FReceiptAPI.GetShiftStatusCurl(LocalShiftId, Response, ShiftStatus) and
       Assigned(ShiftStatus) then
    begin
      // [NEW] Перевірка скоупу: зміна має належати поточній касі
      if (ShiftStatus.CashRegisterId <> '') and
         (ShiftStatus.CashRegisterId <> FReceiptAPI.CurrentCashRegisterId) then
      begin
        Log('⚠️ SHIFT-GUARD: локальний ID ' + Copy(LocalShiftId, 1, 8) +
            '... належить ІНШІЙ касі (' +
            Copy(ShiftStatus.CashRegisterId, 1, 8) + '... ≠ ' +
            Copy(FReceiptAPI.CurrentCashRegisterId, 1, 8) + '...). Очищаємо.');
        ScopeMismatch := True;
        FreeAndNil(ShiftStatus);
        ClearShiftState;
        // НЕ Exit — йдемо відкривати нову зміну на НАШІЙ касі
      end
      else if ShiftStatus.Status = 'OPENED' then
      begin
        // ✅ Локальна зміна підтверджена сервером і належить нашій касі
        try
          Log('ℹ️ Зміна вже відкрита: ' + Copy(ShiftStatus.Id, 1, 8) +
              '... №' + IntToStr(ShiftStatus.Serial));

          // [FIX] реальний номер зміни замість "№?"
          if ShiftStatus.Serial > 0 then
            ShiftInfo := '№' + IntToStr(ShiftStatus.Serial)
          else
            ShiftInfo := '';

          UpdateShiftStatus(svOpened, ShiftInfo);
          edtShiftId.Text := LocalShiftId;
          btnCloseShiftSimpleCurl.Enabled := True;

          ShowMessage('Зміна вже відкрита.' + sLineBreak +
                      IfThen(ShiftStatus.Serial > 0,
                        'Номер: ' + IntToStr(ShiftStatus.Serial),
                        'ID: ' + Copy(LocalShiftId, 1, 8) + '...'));
        finally
          FreeAndNil(ShiftStatus);
        end;
        Exit;
      end
      else
      begin
        // Статус не OPENED (CLOSED, ERROR, ...) — локальний ID застарілий
        Log('⚠️ SHIFT-GUARD: локальний ID ' + Copy(LocalShiftId, 1, 8) +
            '... має статус ' + ShiftStatus.Status + ' — очищаємо');
        FreeAndNil(ShiftStatus);
        ClearShiftState;
        // не Exit — йдемо відкривати нову зміну
      end;
    end
    else
    begin
      // Не вдалося отримати статус (мережа / 404) — звільняємо і йдемо далі.
      // SHIFT-GUARD всередині OpenShiftCurl захистить від дублювання.
      if Assigned(ShiftStatus) then
        FreeAndNil(ShiftStatus);
    end;
  end;

  // Наступні перевірки API та відкриття зміни
  if not ValidateAPIState(False, True) then
    Exit;

  UpdateShiftStatus(svProcessing);
  btnOpenShift.Enabled := False;
  Screen.Cursor := crHourGlass;

  try
    try
      if FReceiptAPI.OpenShiftCurl('', '', '', Response, ShiftStatus) then
      begin
        if Assigned(ShiftStatus) and (ShiftStatus.Status = 'OPENED') then
        begin
          // [FIX] Serial з відповіді API (якщо є)
          if ShiftStatus.Serial > 0 then
            ShiftInfo := '№' + IntToStr(ShiftStatus.Serial)
          else
            ShiftInfo := '';

          UpdateShiftStatus(svOpened, ShiftInfo);
          edtShiftId.Text := FReceiptAPI.CurrentShiftId;
          btnCloseShiftSimpleCurl.Enabled := True;

          if Response = 'SHIFT_ALREADY_OPENED' then
            ShowMessage('ℹ️ Зміна вже була відкрита. Синхронізовано.' +
              IfThen(ShiftStatus.Serial > 0,
                sLineBreak + 'Номер: ' + IntToStr(ShiftStatus.Serial), ''))
          else if ScopeMismatch then
            ShowMessage('✅ Відкрито нову зміну на цій касі.' +
              IfThen(ShiftStatus.Serial > 0,
                sLineBreak + 'Номер: ' + IntToStr(ShiftStatus.Serial), '') +
              sLineBreak +
              '(локальний стан було скинуто — він вказував на іншу касу)')
          else
            ShowMessage('✅ Зміну успішно відкрито!' +
              IfThen(ShiftStatus.Serial > 0,
                sLineBreak + 'Номер: ' + IntToStr(ShiftStatus.Serial), ''));
        end
        else
        begin
          if Assigned(ShiftStatus) then
            Log('❌ Статус зміни: ' + ShiftStatus.Status)
          else
            Log('❌ ShiftStatus не повернуто, хоча OpenShiftCurl повернув True');

          UpdateShiftStatus(svError);
          ShowMessage('❌ Помилка: зміна не відкрита. Статус: ' +
            IfThen(Assigned(ShiftStatus), ShiftStatus.Status, 'не визначено'));
        end;
      end
      else
      begin
        UpdateShiftStatus(svError);
        if Pos('вже виконується', LowerCase(Response)) > 0 then
          Log('⚠️ ' + Response)
        else
          ShowMessage('❌ Помилка відкриття зміни:' + sLineBreak +
                      Copy(Response, 1, 300));
      end;
    except
      on E: Exception do
      begin
        Log('❌ Виняток у btnOpenShiftClick: ' + E.Message);
        UpdateShiftStatus(svError);
        ShowMessage('Критична помилка: ' + E.Message);
      end;
    end;
  finally
    btnOpenShift.Enabled := True;
    Screen.Cursor := crDefault;

    if Assigned(ShiftStatus) then
      FreeAndNil(ShiftStatus);

    // Оновлення статусу каси для UI
    if Assigned(FReceiptAPI) and (FReceiptAPI.CurrentCashRegisterId <> '') then
    begin
      CRStatus := nil;
      if FReceiptAPI.GetCashRegisterStatusCurl(FReceiptAPI.CurrentCashRegisterId,
           Response, CRStatus) then
      begin
        try
          if Assigned(CRStatus) then
            Log('Статус каси оновлено: OfflineMode=' +
                BoolToStr(CRStatus.OfflineMode, True) +
                ', ShiftStatus=' + CRStatus.ShiftStatus);
        finally
          if Assigned(CRStatus) then
            FreeAndNil(CRStatus);
        end;
      end
      else
        Log('⚠️ Не вдалося оновити статус каси: ' + Copy(Response, 1, 100));
    end;
  end;
end;


