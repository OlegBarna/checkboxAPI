  end;

  Result := True;
end;

function TFmChek.ValidateAPIState(RequireShift: Boolean = False;
                                 RequireCashRegister: Boolean = False;
                                 RequireCashRegisterList: Boolean = False): Boolean;
var
  ErrorMessage: string;
  AuthResponse: string;
begin
  Result := False;

  // 1. Перевірка активованості Checkbox API
  if not UseCheckboxAPI then
  begin
    UpdateAPIStatus(svDisabled);
    ShowMessage('Функціонал Checkbox API вимкнено в налаштуваннях');
    Exit;
  end;

  // 2. Перевірка ініціалізації API
  if not Assigned(FReceiptAPI) then
  begin
    Log('API не ініціалізовано!');

    // Спроба автоматичної ініціалізації
    try
      FReceiptAPI := TReceiptWebAPI.Create(
        edtBaseURL.Text,
        edtClientName.Text,
        edtClientVersion.Text,
        edtLicenseKey.Text,
        @Self.Log
      );
      Log('API автоматично ініціалізовано');
      UpdateAPIStatus(svReady);
    except
      on E: Exception do
      begin
        UpdateAPIStatus(svError);
        ShowMessage('Помилка ініціалізації API: ' + E.Message);
        Exit;
      end;
    end;
  end;

  // 3. Перевірка та оновлення авторизації
  if not CheckAndRenewAuth(AuthResponse) then
  begin
    if FReceiptAPI.IsNetworkError(AuthResponse) then
    begin
      UpdateAPIStatus(svOffline, 'Немає зв''язку');
      UpdateCashierStatus(svError, 'Мережа');
      // debounce — щоб не показувати двічі підряд
      if MilliSecondsBetween(Now, FLastAuthErrorShownAt) > 2500 then
      begin
        ShowMessage(
          'Помилка мережі: немає зв''язку з сервером Checkbox.' + sLineBreak +
          'Перевірте інтернет і доступність:' + sLineBreak +
          edtBaseURL.Text);
        FLastAuthErrorShownAt := Now;
      end;
    end
    else
    begin
      UpdateAPIStatus(svError, 'Помилка авторизації');
      UpdateCashierStatus(svError, 'Авторизація');
      if MilliSecondsBetween(Now, FLastAuthErrorShownAt) > 2500 then
      begin
        ShowMessage('Не вдалося авторизуватися. Перевірте логін, пароль/PIN і налаштування.');
        FLastAuthErrorShownAt := Now;
      end;
    end;
    Exit;
  end;

  // 4. Перевірка дійсності токена
  if not FReceiptAPI.IsTokenValid then
  begin
    UpdateCashierStatus(svError);
    ShowMessage('Токен недійсний. Спробуйте увійти знову.');
    Exit;
  end;

  // 5. Додаткові перевірки за потребою
  if RequireCashRegister and (FReceiptAPI.CurrentCashRegisterId = '') then
  begin
    UpdateCashRegisterStatus(svError);
    ShowMessage('ID каси не встановлено. Ініціалізуйте касу.');
    Exit;
  end;

  if RequireShift and (FReceiptAPI.CurrentShiftId = '') then
  begin
    UpdateShiftStatus(svClosed);
    ShowMessage('Зміна не відкрита. Спочатку відкрийте зміну.');
    Exit;
  end;

  // 6. Перевірка списку кас (якщо потрібно)
  if RequireCashRegisterList and (Length(FCashRegisters) = 0) then
  begin
    Log('Список кас порожній, намагаємося оновити...');
    RefreshCashRegisterList;  // Викликаємо оновлення списку
    if Length(FCashRegisters) = 0 then
    begin
      UpdateCashRegisterStatus(svError);
      ShowMessage('Не вдалося завантажити список кас. Перевірте зʼєднання з Checkbox.');
      Exit;
    end;
  end;

  // Якщо всі перевірки пройдено успішно
  UpdateAPIStatus(svOnline);
  UpdateCashierStatus(svOnline);

  // Оновлюємо статус каси, якщо вона встановлена (з урахуванням offline-стану)
  if FReceiptAPI.CurrentCashRegisterId <> '' then
  begin
    if ReadOfflineModeEnabled and IsLocallyOffline then
      UpdateCashRegisterStatus(svOffline)
    else
      UpdateCashRegisterStatus(svReady);
  end;

  // Оновлюємо статус зміни, якщо вона відкрита
  if FReceiptAPI.CurrentShiftId <> '' then
    UpdateShiftStatus(svOpened);

  Result := True;
end;


